true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-gb\"></use></svg>EN</a>\n<a aria-current=\"true\" class=\"menu__lang\" data-lang=\"ru\" href=\"/ru/verticals/sweepstakes/\" hreflang=\"ru\" lang=\"ru\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-ru\"></use></svg>RU</a>\n<a aria-current=\"false\" class=\"menu__lang\" data-lang=\"uk\" href=\"/uk/verticals/sweepstakes/\" hreflang=\"uk\" lang=\"uk\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-ua\"></use></svg>UK</a>\n<a aria-current=\"false\" class=\"menu__lang\" data-lang=\"es\" href=\"/es/verticals/sweepstakes/\" hreflang=\"es\" lang=\"es\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-es\"></use></svg>ES</a>\n<a aria-current=\"false\" class=\"menu__lang\" data-lang=\"cs\" href=\"/cs/verticals/sweepstakes/\" hreflang=\"cs\" lang=\"cs\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-cz\"></use></svg>CS</a></div>\n</div>\n<div class=\"menu__contact\">\n<span class=\"mono\">Общие вопросы</span>\n<a href=\"mailto:hello@ironvane-media.com\">hello@ironvane-media.com</a>\n</div>\n</div>\n</div>\n</div><div aria-labelledby=\"read-bar-label\" class=\"read-bar\" data-read-bar=\"\" hidden=\"\"><i></i><span class=\"visually-hidden\" id=\"read-bar-label\">Прогресс чтения</span></div>", "main": "\n<section class=\"page-hero\">\n<div class=\"container\">\n<nav aria-label=\"Хлебные крошки\" class=\"breadcrumb\" style=\"margin-bottom:24px\"><a href=\"/ru/\">Главная</a><span aria-hidden=\"true\">/</span><a href=\"/ru/verticals/\">Вертикали</a><span aria-hidden=\"true\">/</span><span>Свипстейки и утилиты</span></nav>\n<div class=\"vhero\">\n<div class=\"vhero__text\">\n<p class=\"eyebrow\">Массовый охват</p>\n<h1 class=\"page-hero__title balance\">Свипстейки и утилиты</h1>\n<p class=\"page-hero__lead lead pretty\">Самый дешёвый вход из всех вертикалей — и самая дорогая ошибка на объёме.</p>\n</div>\n<aside class=\"vhero__aside\">\n<div class=\"vhero__top\">\n<svg aria-hidden=\"true\" class=\"vhero__mark\" fill=\"none\" focusable=\"false\" height=\"92\" viewbox=\"0 0 24 24\" width=\"92\"><path d=\"M12 0c0 6.627 5.373 12 12 12-6.627 0-12 5.373-12 12 0-6.627-5.373-12-12-12C6.627 12 12 6.627 12 0Z\" fill=\"url(#sparkleGrad)\"></path></svg>\n<p class=\"vhero__figure\"><b>3</b><span>партнёрки</span></p>\n</div>\n<ul class=\"vhero__list\">\n<li>ClickDealer</li>\n<li>MaxBounty</li>\n<li>Zorka.Network</li>\n</ul>\n</aside>\n</div>\n</div>\n</section>\n<section class=\"section section--line\">\n<div class=\"container\">\n<div class=\"section-head\" data-reveal=\"\">\n<p class=\"eyebrow\">Что это за трафик</p>\n</div>\n<div class=\"vwhat\">\n<p data-reveal=\"\" style=\"--d:0\">Свипстейки и мобильные утилиты дают простое действие, низкий барьер и широкую аудиторию. Тесты здесь стоят копейки и делаются десятками, а результат виден быстро.</p>\n<p data-reveal=\"\" style=\"--d:1\">Ровно поэтому тут легче всего потерять деньги. Ошибка, стоившая пять долларов на тесте, стоит пять тысяч на объёме, а сигнал о ней приходит с задержкой. Дисциплина отсечения слабых связок здесь важнее, чем поиск сильных.</p>\n</div>\n</div>\n</section>\n<section class=\"section section--line\">\n<div class=\"container\">\n<div class=\"section-head\" data-reveal=\"\">\n<p class=\"eyebrow\">Что отличает экономику</p>\n<h2 class=\"h2 balance\">Массовый охват</h2>\n</div>\n<div class=\"metrics\">\n<div class=\"metric\" data-reveal=\"\" style=\"--d:0\"><span class=\"metric__num num\">01</span><h3 class=\"metric__title\">Цена действия</h3><p class=\"metric__text\">Низкая настолько, что колебания в процентах обманчивы. Смотрим на абсолют и объём одновременно.</p></div>\n<div class=\"metric\" data-reveal=\"\" style=\"--d:1\"><span class=\"metric__num num\">02</span><h3 class=\"metric__title\">Скорость ротации</h3><p class=\"metric__text\">Сколько связок проходит через тест за неделю. Ниже определённого темпа вертикаль не окупается.</p></div>\n<div class=\"metric\" data-reveal=\"\" style=\"--d:2\"><span class=\"metric__num num\">03</span><h3 class=\"metric__title\">Качество на стороне партнёра</h3><p class=\"metric__text\">Дешёвое действие ничего не стоит, если не доходит до оплаты. Сверяемся чаще, чем в других вертикалях.</p></div>\n</div>\n</div>\n</section>\n<section class=\"section section--line\">\n<div class=\"container\">\n<div class=\"section-head\" data-reveal=\"\">\n<p class=\"eyebrow\">Как мы это закупаем</p>\n</div>\n<div class=\"pass-steps\">\n<div class=\"pass-step\" data-reveal=\"\" style=\"--d:0\"><span class=\"pass-step__num num\">01</span><h3 class=\"pass-step__title\">Оффер и экономика</h3><p class=\"pass-step__text\">Фиксируем целевую цену действия и то, какое событие считается качественным, — до того как потрачен первый доллар.</p></div>\n<div class=\"pass-step\" data-reveal=\"\" style=\"--d:1\"><span class=\"pass-step__num num\">02</span><h3 class=\"pass-step__title\">Источники и связка</h3><p class=\"pass-step__text\">Подбираем каналы под вертикаль и собираем связку: гео, креатив, преленд, оффер.</p></div>\n<div class=\"pass-step\" data-reveal=\"\" style=\"--d:2\"><span class=\"pass-step__num num\">03</span><h3 class=\"pass-step__title\">Тест</h3><p class=\"pass-step__text\">Запуск с заранее заданными условиями остановки и масштабирования. Решение принимает цифра, а не настроение.</p></div>\n<div class=\"pass-step\" data-reveal=\"\" style=\"--d:3\"><span class=\"pass-step__num num\">04</span><h3 class=\"pass-step__title\">Объём</h3><p class=\"pass-step__text\">Масштабируем только то, что подтвердилось на тесте, и держим экономику под контролем на росте.</p></div>\n</div>\n</div>\n</section>\n<section class=\"section section--line\" id=\"programmes\">\n<div class=\"container\">\n<div class=\"section-head\" data-reveal=\"\">\n<p class=\"eyebrow\">Партнёрские программы</p>\n<h2 class=\"h2 balance\">3 партнёрки</h2>\n<p class=\"lead pretty\">Программы, с которыми мы работаем в этой вертикали.</p>\n</div>\n<div class=\"progs\">\n<a class=\"prog\" data-reveal=\"\" href=\"https://clickdealer.com/\" rel=\"noopener noreferrer\" style=\"--d:0\" target=\"_blank\"><h3 class=\"prog__name\">ClickDealer</h3><p class=\"prog__text\">Глобальная CPA-сеть, широкий набор вертикалей.</p><span class=\"prog__link\">clickdealer.com</span></a>\n<a class=\"prog\" data-reveal=\"\" href=\"https://maxbounty.com/\" rel=\"noopener noreferrer\" style=\"--d:1\" target=\"_blank\"><h3 class=\"prog__name\">MaxBounty</h3><p class=\"prog__text\">CPA-сеть с фокусом на Северную Америку.</p><span class=\"prog__link\">maxbounty.com</span></a>\n<a class=\"prog\" data-reveal=\"\" href=\"https://zorka.network/\" rel=\"noopener noreferrer\" style=\"--d:2\" target=\"_blank\"><h3 class=\"prog__name\">Zorka.Network</h3><p class=\"prog__text\">Партнёрский и инфлюенс-маркетинг, мобильные приложения.</p><span class=\"prog__link\">zorka.network</span></a>\n</div>\n</div>\n</section>\n<section class=\"cta-band\">\n<svg aria-hidden=\"true\" class=\"sparkle cta-band__spark\" fill=\"none\" focusable=\"false\" height=\"34\" viewbox=\"0 0 24 24\" width=\"34\"><path d=\"M12 0c0 6.627 5.373 12 12 12-6.627 0-12 5.373-12 12 0-6.627-5.373-12-12-12C6.627 12 12 6.627 12 0Z\" fill=\"url(#sparkleGrad)\"></path></svg>\n<div class=\"container\">\n<div class=\"cta-band__inner\" data-reveal=\"\">\n<h2 class=\"cta-band__title balance\">Нужен объём в этой вертикали?</h2>\n<p class=\"cta-band__lead pretty\">Опишите продукт, гео и целевую цену действия — ответим, что здесь реально, а что нет.</p>\n<div class=\"cta-band__actions\"><a class=\"btn btn--primary\" href=\"/ru/contact/\"><span>Прислать оффер</span><svg aria-hidden=\"true\" class=\"btn__icon\" fill=\"none\" height=\"14\" viewbox=\"0 0 14 14\" width=\"14\"><path d=\"M1 7h11M8 3l4 4-4 4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg></a></div>\n</div>\n</div>\n</section>\n", "footer": "\n<div class=\"container\">\n<div class=\"footer__top\">\n<div class=\"footer__brand\">\n<a aria-label=\"Ironvane Media\" class=\"logo\" href=\"/ru/\">\n<svg aria-hidden=\"true\" class=\"logo__mark\" fill=\"none\" height=\"22\" viewbox=\"0 0 24 24\" width=\"22\"><defs><lineargradient gradientunits=\"userSpaceOnUse\" id=\"ivmMarkf\" x1=\"4\" x2=\"20\" y1=\"0\" y2=\"24\"><stop stop-color=\"#ffffff\"></stop><stop offset=\"0.45\" stop-color=\"#c9ccd2\"></stop><stop offset=\"0.7\" stop-color=\"#82868f\"></stop><stop offset=\"1\" stop-color=\"#ffffff\"></stop></lineargradient></defs><path d=\"M12 0c0 6.627 5.373 12 12 12-6.627 0-12 5.373-12 12 0-6.627-5.373-12-12-12C6.627 12 12 6.627 12 0Z\" fill=\"url(#ivmMarkf)\"></path></svg>\n<span class=\"logo__type\"><span class=\"logo__name\">Ironvane Media</span><span class=\"logo__sub\">Performance systems</span></span>\n</a>\n<p class=\"footer__tagline\">Европейская performance-компания. Креативная стратегия, медиабаинг и аналитика работают одной системой на 73 рынках.</p>\n</div>\n<div class=\"footer__col\"><span class=\"footer__key\">Компания</span><a class=\"footer__link\" href=\"/ru/about/\">О компании</a>\n<a class=\"footer__link\" href=\"/ru/pass/\">Подписки</a>\n<a class=\"footer__link\" href=\"/ru/verticals/\">Вертикали</a>\n<a class=\"footer__link\" href=\"/ru/results/\">Результаты</a>\n<a class=\"footer__link\" href=\"/ru/careers/\">Карьера</a>\n<a class=\"footer__link\" href=\"/ru/contact/\">Контакты</a></div>\n<div class=\"footer__col\"><span class=\"footer__key\">Услуги</span><a class=\"footer__link\" href=\"/ru/services/#creative-strategy\">Креативная стратегия</a>\n<a class=\"footer__link\" href=\"/ru/services/#performance-marketing\">Performance-маркетинг</a>\n<a class=\"footer__link\" href=\"/ru/services/#analytics\">Аналитика</a>\n<a class=\"footer__link\" href=\"/ru/servic