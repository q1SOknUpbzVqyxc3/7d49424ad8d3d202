"0 0 12 12\" width=\"12\"><path d=\"M3 9L9 3M9 3H4M9 3v5\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.3\"></path></svg></a><a class=\"menu__ext-link\" href=\"https://teletype.in/@ironvane/Partnership\" hreflang=\"ru\" rel=\"noopener noreferrer\" target=\"_blank\"><span>Партнерство</span><svg aria-hidden=\"true\" fill=\"none\" height=\"12\" viewbox=\"0 0 12 12\" width=\"12\"><path d=\"M3 9L9 3M9 3H4M9 3v5\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.3\"></path></svg></a><a class=\"menu__ext-link\" href=\"https://teletype.in/@ironvane/IronvanePass\" hreflang=\"ru\" rel=\"noopener noreferrer\" target=\"_blank\"><span>Ironvane Pass</span><svg aria-hidden=\"true\" fill=\"none\" height=\"12\" viewbox=\"0 0 12 12\" width=\"12\"><path d=\"M3 9L9 3M9 3H4M9 3v5\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.3\"></path></svg></a></div><div class=\"menu__ext menu__ext--tight\" data-menu-ext=\"\"><span class=\"mono menu__ext-label\">Ми в Telegram</span><a class=\"menu__ext-link\" href=\"https://t.me/+-lN8N8R_91UzYjc0\" hreflang=\"ru\" rel=\"noopener noreferrer\" target=\"_blank\"><span>Чат команди</span><svg aria-hidden=\"true\" fill=\"none\" height=\"12\" viewbox=\"0 0 12 12\" width=\"12\"><path d=\"M3 9L9 3M9 3H4M9 3v5\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.3\"></path></svg></a></div>\n<div class=\"menu__foot\">\n<div class=\"menu__contact\">\n<span class=\"mono\">Мова</span>\n<div class=\"menu__langs\"><a aria-current=\"false\" class=\"menu__lang\" data-lang=\"en\" href=\"/en/contact/\" hreflang=\"en\" lang=\"en\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-gb\"></use></svg>EN</a>\n<a aria-current=\"false\" class=\"menu__lang\" data-lang=\"ru\" href=\"/ru/contact/\" hreflang=\"ru\" lang=\"ru\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-ru\"></use></svg>RU</a>\n<a aria-current=\"true\" class=\"menu__lang\" data-lang=\"uk\" href=\"/uk/contact/\" hreflang=\"uk\" lang=\"uk\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-ua\"></use></svg>UK</a>\n<a aria-current=\"false\" class=\"menu__lang\" data-lang=\"es\" href=\"/es/contact/\" hreflang=\"es\" lang=\"es\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-es\"></use></svg>ES</a>\n<a aria-current=\"false\" class=\"menu__lang\" data-lang=\"cs\" href=\"/cs/contact/\" hreflang=\"cs\" lang=\"cs\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-cz\"></use></svg>CS</a></div>\n</div>\n<div class=\"menu__contact\">\n<span class=\"mono\">Загальні питання</span>\n<a href=\"mailto:hello@ironvane-media.com\">hello@ironvane-media.com</a>\n</div>\n</div>\n</div>\n</div><div aria-labelledby=\"read-bar-label\" class=\"read-bar\" data-read-bar=\"\" hidden=\"\"><i></i><span class=\"visually-hidden\" id=\"read-bar-label\">Прогрес читання</span></div>", "main": "\n<section class=\"page-hero\">\n<div class=\"container\">\n<nav aria-label=\"Навігаційний ланцюжок\" class=\"breadcrumb\" style=\"margin-bottom:24px\"><a href=\"/uk/\">Головна</a><span aria-hidden=\"true\">/</span><span>Контакти</span></nav>\n<p class=\"eyebrow\">Контакти</p>\n<h1 class=\"page-hero__title balance\">Розкажіть, яку метрику треба зрушити.</h1>\n<p class=\"page-hero__lead lead pretty\">Що конкретніше ви опишете продукт, ринок і обмеження, то кориснішою буде наша перша відповідь. Відповідаємо протягом 24 годин з моменту звернення.</p>\n</div>\n</section>\n<section class=\"section section--flush-top\">\n<div class=\"container\">\n<div class=\"contact-layout\">\n<div data-reveal=\"\">\n<div class=\"info-list\">\n<div class=\"info-row\"><span class=\"info-row__key\">Загальні питання</span><span class=\"info-row__val\"><a href=\"mailto:hello@ironvane-media.com\">hello@ironvane-media.com</a></span></div>\n<div class=\"info-row\"><span class=\"info-row__key\">Кар'єра</span><span class=\"info-row__val\"><a href=\"mailto:careers@ironvane-media.com\">careers@ironvane-media.com</a></span></div>\n<div class=\"info-row\"><span class=\"info-row__key\">Telegram</span><span class=\"info-row__val\"><a href=\"https://t.me/ironvane\" rel=\"noopener noreferrer\" target=\"_blank\">@ironvane</a></span></div>\n<div class=\"info-row\"><span class=\"info-row__key\">Час відповіді</span><span class=\"info-row__val\">До 24 годин</span></div>\n<div class=\"info-row\"><span class=\"info-row__key\">Працюємо мовами</span><span class=\"info-row__val\">англійська, російська, українська, іспанська, чеська, німецька, польська, португальська, турецька</span></div>\n</div>\n<h2 class=\"h3\" style=\"margin-top:52px\">Що буде далі</h2>\n<div class=\"expect\"><div class=\"expect__item\"><span class=\"expect__num\">01</span><div><h3 class=\"expect__title\">Ми прочитаємо уважно</h3><p class=\"expect__text\">Ваш лист читає senior-фахівець, а не форма-маршрутизатор. Якщо ми не підходимо — скажемо прямо і підкажемо, до кого звернутися.</p></div></div>\n<div class=\"expect__item\"><span class=\"expect__num\">02</span><div><h3 class=\"expect__title\">Дзвінок на 30 хвилин</h3><p class=\"expect__text\">Продукт, ринок, поточна економіка, що вже пробували. Без презентацій і ритуального discovery.</p></div></div>\n<div class=\"expect__item\"><span class=\"expect__num\">03</span><div><h3 class=\"expect__title\">Письмова оцінка</h3><p class=\"expect__text\">За кілька днів ви отримуєте чесний розбір: де можливість, чого це потребуватиме і до чого ми не стали б торкатися.</p></div></div></div>\n</div>\n<div class=\"form-wrap\" data-reveal=\"\">\n<form action=\"/api/lead\" class=\"form\" data-endpoint=\"/api/lead\" data-form=\"\" data-mailto=\"hello@ironvane-media.com\" method=\"post\" novalidate=\"\">\n<div aria-hidden=\"true\" class=\"hp\"><label>Website<input autocomplete=\"off\" name=\"website\" tabindex=\"-1\" type=\"text\"/></label></div>\n<p class=\"form__title\">Заявка на проєкт</p>\n<div aria-label=\"Компанія / Приватна особа\" class=\"form__mode\" role=\"group\">\n<button aria-pressed=\"true\" class=\"mode is-active\" data-mode=\"company\" type=\"button\">Компанія</button>\n<button aria-pressed=\"false\" class=\"mode\" data-mode=\"person\" type=\"button\">Приватна особа</button>\n</div>\n<input name=\"mode\" type=\"hidden\" value=\"company\"/>\n<div class=\"form__grid\">\n<div class=\"field\"><label class=\"field__label\" for=\"contact-name\">Ім'я</label><input aria-describedby=\"contact-name-err\" autocomplete=\"name\" id=\"contact-name\" name=\"name\" placeholder=\"Як до вас звертатися\" required=\"\" type=\"text\"/><span class=\"field__error\" id=\"contact-name-err\">Обов'язкове поле</span></div>\n<div class=\"field\"><label class=\"field__label\" for=\"contact-email\">Email</label><input aria-describedby=\"contact-email-err\" autocomplete=\"email\" id=\"contact-email\" name=\"email\" placeholder=\"you@company.com\" required=\"\" type=\"email\"/><span class=\"field__error\" id=\"contact-email-err\">Введіть коректний email</span></div>\n<div class=\"field\" data-when=\"company\"><label class=\"field__label\" for=\"contact-company\">Компанія</label><input aria-describedby=\"contact-company-err\" autocomplete=\"organization\" id=\"contact-company\" name=\"company\" placeholder=\"Назва компанії\" required=\"\" type=\"text\"/><span class=\"field__error\" id=\"contact-company-err\">Обов'язкове поле</span></div>\n<div class=\"field\" data-when=\"company\"><label class=\"field__label\" for=\"contact-country\">Країна або ринок</label><input aria-describedby=\"contact-country-err\" autocomplete=\"country-name\" id=\"contact-country\" name=\"country\" placeholder=\"Де ви працюєте\" required=\"\" type=\"text\"/><span class=\"field__error\" id=\"contact