false\" viewbox=\"0 0 16 12\"><use href=\"#flag-gb\"></use></svg>EN</a>\n<a aria-current=\"false\" class=\"menu__lang\" data-lang=\"ru\" href=\"/ru/services/\" hreflang=\"ru\" lang=\"ru\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-ru\"></use></svg>RU</a>\n<a aria-current=\"false\" class=\"menu__lang\" data-lang=\"uk\" href=\"/uk/services/\" hreflang=\"uk\" lang=\"uk\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-ua\"></use></svg>UK</a>\n<a aria-current=\"false\" class=\"menu__lang\" data-lang=\"es\" href=\"/es/services/\" hreflang=\"es\" lang=\"es\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-es\"></use></svg>ES</a>\n<a aria-current=\"true\" class=\"menu__lang\" data-lang=\"cs\" href=\"/cs/services/\" hreflang=\"cs\" lang=\"cs\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-cz\"></use></svg>CS</a></div>\n</div>\n<div class=\"menu__contact\">\n<span class=\"mono\">Obecné dotazy</span>\n<a href=\"mailto:hello@ironvane-media.com\">hello@ironvane-media.com</a>\n</div>\n</div>\n</div>\n</div><div aria-labelledby=\"read-bar-label\" class=\"read-bar\" data-read-bar=\"\" hidden=\"\"><i></i><span class=\"visually-hidden\" id=\"read-bar-label\">Průběh čtení</span></div>", "main": "\n<section class=\"page-hero\">\n<div class=\"container\">\n<nav aria-label=\"Drobečková navigace\" class=\"breadcrumb\" style=\"margin-bottom:24px\"><a href=\"/cs/\">Úvod</a><span aria-hidden=\"true\">/</span><span>Služby</span></nav>\n<p class=\"eyebrow\">Služby</p>\n<h1 class=\"page-hero__title balance\">Šest služeb. Jedna nákupní operace.</h1>\n<p class=\"page-hero__lead lead pretty\">Každá služba je popsaná tak, jak ji skutečně vedeme: jaký problém řeší, jakým přístupem, jakým procesem, co dostanete a jak se posuzuje úspěch. Nic se nebalí do balíčku kvůli výši paušálu.</p>\n</div>\n</section>\n<section class=\"section section--tight\">\n<div class=\"container\">\n<p class=\"mono\" data-reveal=\"\">Přehled služeb</p>\n<div class=\"svc-index\" data-reveal=\"\"><a class=\"svc-index__item\" href=\"#creative-strategy\"><span class=\"svc-index__num\">01</span><span class=\"svc-index__title\">Kreativní strategie</span><span class=\"svc-index__sum\">Systém sdělení, který rozhoduje, co každá reklama říká, proč to říká a jak dlouho zůstane naživu.</span></a>\n<a class=\"svc-index__item\" href=\"#performance-marketing\"><span class=\"svc-index__num\">02</span><span class=\"svc-index__title\">Výkonnostní marketing</span><span class=\"svc-index__sum\">Nákup od začátku do konce vedený proti CPA, které jste souhlasili platit.</span></a>\n<a class=\"svc-index__item\" href=\"#analytics\"><span class=\"svc-index__num\">03</span><span class=\"svc-index__title\">Analytika</span><span class=\"svc-index__sum\">Vrstva měření, která činí všechny ostatní služby odpovědnými.</span></a>\n<a class=\"svc-index__item\" href=\"#cro\"><span class=\"svc-index__num\">04</span><span class=\"svc-index__title\">Optimalizace konverzí</span><span class=\"svc-index__sum\">Oprava té poloviny trychtýře, na kterou nákup médií nedosáhne.</span></a>\n<a class=\"svc-index__item\" href=\"#market-expansion\"><span class=\"svc-index__num\">05</span><span class=\"svc-index__title\">Expanze na nové trhy</span><span class=\"svc-index__sum\">Fázovaná metoda vstupu na trh bez opakovaného placení už zaplacené lekce.</span></a>\n<a class=\"svc-index__item\" href=\"#creative-production\"><span class=\"svc-index__num\">06</span><span class=\"svc-index__title\">Produkce kreativ</span><span class=\"svc-index__sum\">Produkce stavěná na rychlost testování, ne na showreel.</span></a></div>\n</div>\n</section>\n<section class=\"section section--flush-top\">\n<div class=\"container\">\n<article class=\"service\" data-reveal=\"\" id=\"creative-strategy\">\n<div class=\"service__head\">\n<div>\n<span class=\"service__num num\">01</span>\n<h2 class=\"service__title balance\">Kreativní strategie</h2>\n<p class=\"service__kicker\">Výzkum → úhly → koncepty → ověřená sdělení</p>\n</div>\n<div>\n<p class=\"service__summary balance\">Systém sdělení, který rozhoduje, co každá reklama říká, proč to říká a jak dlouho zůstane naživu.</p>\n<div class=\"service__pa\">\n<div class=\"service__pa-block\"><span class=\"service__pa-key\">Problém</span><p>Kreativa se zadává podle vkusu a intuice, takže nikdo neumí vysvětlit, proč jedno video fungovalo. Vítěze nelze zopakovat, únava přijde bez varování a každá obměna začíná od nuly.</p></div>\n<div class=\"service__pa-block\"><span class=\"service__pa-key\">Přístup</span><p>Architekturu sdělení stavíme ještě před produkcí. Výzkum publika vytvoří mapu přesvědčení, námitek a srovnání; z každého úhlu se stane písemná hypotéza s podmínkou úspěchu a určeným místem v trychtýři.</p></div>\n</div>\n</div>\n</div>\n<div class=\"service__detail\">\n<div class=\"service__col\"><span class=\"service__col-key\">Proces</span><ol class=\"step-list\"><li>Výzkum publika, recenzí a sdělení konkurence</li>\n<li>Mapa úhlů: přesvědčení a námitky, které stojí za to napadnout</li>\n<li>Vývoj konceptů s explicitními hypotézami</li>\n<li>Produkční zadání s taxonomií variant a značkováním</li>\n<li>Strukturované testování proti definovaným podmínkám úspěchu</li>\n<li>Sledování únavy a plánovaný kalendář obměny</li></ol></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Co dostanete</span><ul class=\"tick-list\"><li>Architektura sdělení a mapa úhlů</li>\n<li>Knihovna konceptů s hypotézami a značkami</li>\n<li>Zadání pro produkci kreativy</li>\n<li>Plán testů s podmínkami úspěchu</li>\n<li>Kalendář únavy a obměny</li></ul></div>\n<div class=\"service__col\">\n<span class=\"service__col-key\">Výsledek</span>\n<div class=\"service__outcome\" style=\"margin-top:0\"><p class=\"balance\">Víte, která myšlenka drží účet, proč funguje a co ji nahradí dřív, než výkon klesne.</p></div>\n</div>\n</div>\n</article>\n<article class=\"service\" data-reveal=\"\" id=\"performance-marketing\">\n<div class=\"service__head\">\n<div>\n<span class=\"service__num num\">02</span>\n<h2 class=\"service__title balance\">Výkonnostní marketing</h2>\n<p class=\"service__kicker\">Strategie → akvizice → nákup → optimalizace → škálování</p>\n</div>\n<div>\n<p class=\"service__summary balance\">Nákup od začátku do konce vedený proti CPA, které jste souhlasili platit.</p>\n<div class=\"service__pa\">\n<div class=\"service__pa-block\"><span class=\"service__pa-key\">Problém</span><p>Útrata roste, dashboardy vypadají zaneprázdněně a cena za vklad tiše stoupá. Kanály se optimalizují izolovaně, funkční kombinaci nikdo nevyčlení a za číslo, na kterém záleží, nikdo neodpovídá.</p></div>\n<div class=\"service__pa-block\"><span class=\"service__pa-key\">Přístup</span><p>Nejdřív nastavíme cílovou ekonomiku — cenu za instalaci, cenu za první vklad, cap, který můžete platit — a teprve pak navrhneme strukturu kanálů a nákupní pravidla, která ji udrží i v objemu.</p></div>\n</div>\n</div>\n</div>\n<div class=\"service__detail\">\n<div class=\"service__col\"><span class=\"service__col-key\">Proces</span><ol class=\"step-list\"><li>Ekonomika nabídky a modelování cílového CPA / CPI</li>\n<li>Strategie kanálů a rozdělení rozpočtu</li>\n<li>Architektura účtu postavená pro čistý signál</li>\n<li>Spuštění s definovanými kritérii ukončení a škálování</li>\n<li>Týdenní optimalizace řízená předem dohodnutými pravidly</li>\n<li>Kontrolované škálování do ověřených buněk a trhů</li></ol></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Co dostanete</span><ul class=\"tick-list\"><li>Akviziční strategie a plán rozpočtu</li>\n<li>Architektura kampaní a standard pojmenování</li>\n<li>Týdenní přehled výkonu a záznam rozhodnutí</li>\n<li>Plán škálování s prahy rizika</li>\n<li>Měsíční report proti cílové ekonomice</li></ul></div>\n<div class=\"service__col\">\n<span class=\"service__col-key\">Výsledek</span>\n<div class=\"service__outcome\" style=\"margin-top:0\"><p class=\"balance\">Předvídatelný objem akvizice za cenu, podle které se dá plánovat, a zdokumentovaný důvod za každým pohybem rozpočtu.</p></div>\n</div>\n</div>\n</article>\n<article class=\"service\" data-reveal=\"\" id=\"analytics\">\n<div class=\"service__head\">\n<div>\n<span class=\"service__num num\">03</span>\n<h2 class=\"service__title balance\">Analytika</h2>\n<p class=\"service__kicker\">Měření → atribuce → kohorty → rozhodnutí</p>\n</div>\n<div>\n<p class=\"service__summary balance\">Vrstva měření, která činí všechny ostatní služby odpovědnými.</p>\n<div class=\"service__pa\">\n<div class=\"service__pa-block\"><span class=\"service__pa-key\">Problém</span><p>Tři nástroje hlásí tři různé pravdy. Atribuční okna se nikdy neodsouhlasila, události pojmenoval ten, kdo je nasazoval, a sestavení reportu trvá den, kterému stejně nikdo nevěří.</p></div>\n<div class=\"service__pa-block\"><span class=\"service__pa-key\">Přístup</span><p>K měření přistupujeme jako k infrastruktuře: jedno schéma událostí, jedna dohoda o atribuci, jedna reportingová vrstva. Každé číslo je zrekonstruovatelné ze surových událostí, jinak se nepublikuje.</p></div>\n</div>\n</div>\n</div>\n<div class=\"service__detail\">\n<div class=\"service__col\"><span class=\"service__col-key\">Proces</span><ol class=\"step-list\"><li>Audit měření a analýza mezer</li>\n<li>Návrh a implementace schématu událostí</li>\n<li>Volba a dokumentace atribučního modelu</li>\n<li>Analýza trychtýře, kohort a retence</li>\n<li>Dashboardy pro nákup, kreativu a protistranu</li>\n<li>Testy inkrementality tam, kde to rozpočet dovolí</li></ol></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Co dostanete</span><ul class=\"tick-list\"><li>Implementace měření a její kontrola</li>\n<li>Zdokumentovaná dohoda o atribuci</li>\n<li>Kohortní a trychtýřová analýza</li>\n<li>Živé dashboardy s určenými vlastníky metrik</li>\n<li>Měsíční report s rozhodnutími</li></ul></div>\n<div class=\"service__col\">\n<span class=\"service__col-key\">Výsledek</span>\n<div class=\"service__outcome\" style=\"margin-top:0\"><p class=\"balance\">Jedna verze pravdy — dost rychlá, aby se podle ní dalo jednat, a dost pevná, aby se podle ní dal plánovat rozpočet.</p></div>\n</div>\n</div>\n</article>\n<article class=\"service\" data-reveal=\"\" id=\"cro\">\n<div class=\"service__head\">\n<div>\n<span class=\"service__num num\">04</span>\n<h2 class=\"service__title balance\">Optimalizace konverzí</h2>\n<p class=\"service__kicker\">Audit → soulad sdělení → testy → ekonomika trychtýře</p>\n</div>\n<div>\n<p class=\"service__summary balance\">Oprava té poloviny trychtýře, na kterou nákup médií nedosáhne.</p>\n<div class=\"service__pa\">\n<div class=\"service__pa-block\"><span class=\"service__pa-key\">Problém</span><p>Z rostoucí ceny za vklad se viní aukce, zatímco landing page odporuje kreativě, registrace chce šest polí a krok vkladu ztratí třetinu hráčů, kteří přišli zaplatit.</p></div>\n<div class=\"service__pa-block\"><span class=\"service__pa-key\">Přístup</span><p>Prověříme celou cestu od kliku po potvrzenou akci, prioritizujeme podle očekávané hodnoty místo podle názorů a testujeme s takovým objemem provozu, který dá odpověď.</p></div>\n</div>\n</div>\n</div>\n<div class=\"service__detail\">\n<div class=\"service__col\"><span class=\"service__col-key\">Proces</span><ol class=\"step-list\"><li>Audit celého trychtýře: stránka, registrace, vklad, onboarding</li>\n<li>Analýza souladu sdělení s běžící kreativou</li>\n<li>Backlog hypotéz ohodnocený podle dopadu a náročnosti</li>\n<li>A/B a multivariantní testy s pevnými pravidly ukončení</li>\n<li>Rychlost a odstranění tření především na mobilu</li>\n<li>Revize cesty po konverzi a aktivace</li></ol></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Co dostanete</span><ul class=\"tick-list\"><li>Audit trychtýře s prioritizovaným backlogem</li>\n<li>Specifikace nebo hotové landing pages</li>\n<li>Výsledky testů se statistickou významností</li>\n<li>Pravidla souladu sdělení pro kreativu</li>\n<li>Reporting konverzí podle segmentů a trhů</li></ul></div>\n<div class=\"service__col\">\n<span class=\"service__col-key\">Výsledek</span>\n<div class=\"service__outcome\" style=\"margin-top:0\"><p class=\"balance\">Vyšší tržby ze stejného mediálního rozpočtu a kreativa, která už nemusí dohánět rozbitou stránku.</p></div>\n</div>\n</div>\n</article>\n<article class=\"service\" data-reveal=\"\" id=\"market-expansion\">\n<div class=\"service__head\">\n<div>\n<span class=\"service__num num\">05</span>\n<h2 class=\"service__title balance\">Expanze na nové trhy</h2>\n<p class=\"service__kicker\">Výzkum → lokalizace → spuštění → validace → škálování</p>\n</div>\n<div>\n<p class=\"service__summary balance\">Fázovaná metoda vstupu na trh bez opakovaného placení už zaplacené lekce.</p>\n<div class=\"service__pa\">\n<div class=\"service__pa-block\"><span class=\"service__pa-key\">Problém</span><p>Na trh se vstupuje překladem vítězné kampaně. Ta si vede hůř z důvodů, které nikdo nediagnostikuje, rozpočet se stáhne a trh se odepíše jako špatný.</p></div>\n<div class=\"service__pa-block\"><span class=\"service__pa-key\">Přístup</span><p>Vstup bereme jako posloupnost s kontrolními body. Výzkum určí věrohodnou ekonomiku, lokalizace přestaví nabídku podle místní logiky a fázované spuštění trh buď ověří, nebo levně uzavře.</p></div>\n</div>\n</div>\n</div>\n<div class=\"service__detail\">\n<div class=\"service__col\"><span class=\"service__col-key\">Proces</span><ol class=\"step-list\"><li>Odhad velikosti trhu, poptávky a konkurence</li>\n<li>Místní požadavky na cenu, platby a compliance</li>\n<li>Lokalizace nabídky a kreativy rodilými mluvčími</li>\n<li>Pilot s předem definovanými kritérii ukončení</li>\n<li>Ověření proti cílové ekonomice</li>\n<li>Plán rozšíření a připravenost místních partnerů</li></ol></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Co dostanete</span><ul class=\"tick-list\"><li>Vstupní zadání s ekonomickým modelem</li>\n<li>Lokalizovaná sdělení a sada kreativ</li>\n<li>Plán pilotu s prahy ukončení a škálování</li>\n<li>Validační report za každý trh</li>\n<li>Plán rolloutu</li></ul></div>\n<div class=\"service__col\">\n<span class=\"service__col-key\">Výsledek</span>\n<div class=\"service__outcome\" style=\"margin-top:0\"><p class=\"balance\">Trhy se otevírají na základě důkazů a zavírají brzy, když jsou důkazy špatné — dřív, než stojí celé čtvrtletí.</p></div>\n</div>\n</div>\n</article>\n<article class=\"service\" data-reveal=\"\" id=\"creative-production\">\n<div class=\"service__head\">\n<div>\n<span class=\"service__num num\">06</span>\n<h2 class=\"service__title balance\">Produkce kreativ</h2>\n<p class=\"service__kicker\">Statika → video → motion → UGC → varianty v objemu</p>\n</div>\n<div>\n<p class=\"service__summary balance\">Produkce stavěná na rychlost testování, ne na showreel.</p>\n<div class=\"service__pa\">\n<div class=\"service__pa-block\"><span class=\"service__pa-key\">Problém</span><p>Kreativa přichází pomalu, v malých dávkách a bez logiky variant. Než se koncept vyrobí, účet už spálil ten předchozí.</p></div>\n<div class=\"service__pa-block\"><span class=\"service__pa-key\">Přístup</span><p>Produkce se plánuje po dávkách s taxonomií variant: hook, důkaz, formát, závěr. Tato struktura umožní analytice přiřadit výkon konkrétnímu prvku, ne celému videu.</p></div>\n</div>\n</div>\n</div>\n<div class=\"service__detail\">\n<div class=\"service__col\"><span class=\"service__col-key\">Proces</span><ol class=\"step-list\"><li>Plánování dávek podle mapy úhlů</li>\n<li>Produkce statiky, videa, motion a UGC</li>\n<li>Systematická obměna hooků, důkazů a závěrů</li>\n<li>Lokalizace a formáty nativní pro platformy</li>\n<li>Předání se značkováním navázaným na reporting</li>\n<li>Vyhodnocení výkonu, které formuje další dávku</li></ol></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Co dostanete</span><ul class=\"tick-list\"><li>Dávky kreativy v pevném rytmu</li>\n<li>Taxonomie variant a značkování assetů</li>\n<li>Lokalizované verze pro každý trh</li>\n<li>Nativní střihy a poměry stran pro platformy</li>\n<li>Vyhodnocení výkonu podle jednotlivých prvků</li></ul></div>\n<div class=\"service__col\">\n<span class=\"service__col-key\">Výsledek</span>\n<div class=\"service__outcome\" style=\"margin-top:0\"><p class=\"balance\">V účtu je dost otestované kreativy na to, aby předběhla únavu, a k tomu data o tom, který prvek odvádí práci.</p></div>\n</div>\n</div>\n</article>\n</div>\n</section>\n<section class=\"cta-band\">\n<svg aria-hidden=\"true\" class=\"sparkle cta-band__spark\" fill=\"none\" focusable=\"false\" height=\"34\" viewbox=\"0 0 24 24\" width=\"34\"><path d=\"M12 0c0 6.627 5.373 12 12 12-6.627 0-12 5.373-12 12 0-6.627-5.373-12-12-12C6.627 12 12 6.627 12 0Z\" fill=\"url(#sparkleGrad)\"></path></svg><svg aria-hidden=\"true\" class=\"sparkle sparkle--sm cta-band__spark cta-band__spark--b\" fill=\"none\" focusable=\"false\" height=\"18\" viewbox=\"0 0 24 24\" width=\"18\"><path d=\"M12 0c0 6.627 5.373 12 12 12-6.627 0-12 5.373-12 12 0-6.627-5.373-12-12-12C6.627 12 12 6.627 12 0Z\" fill=\"url(#sparkleGrad)\"></path></svg>\n<div class=\"container\">\n<div class=\"cta-band__inner\" data-reveal=\"\">\n<h2 class=\"cta-band__title balance\">Nevíte, kterou z nich potřebujete?</h2>\n<p class=\"cta-band__lead pretty\">Většina spoluprací začíná jedním problémem a odhalí další dva. Popište situaci a řekneme vám, co je potřeba spravit první — i kdyby to neměl dělat nikdo od nás.</p>\n<div class=\"cta-band__actions\"><a class=\"btn btn--primary\" href=\"/cs/contact/\"><span>Poslat nabídku</span><svg aria-hidden=\"true\" class=\"btn__icon\" fill=\"none\" height=\"14\" viewbox=\"0 0 14 14\" width=\"14\"><path d=\"M1 7h11M8 3l4 4-4 4\" stroke=\"currentColor\" stroke-li