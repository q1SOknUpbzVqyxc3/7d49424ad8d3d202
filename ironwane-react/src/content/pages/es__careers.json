{"route": "/es/careers/", "locale": "es", "seo": {"title": "Empleo — trabaja en Ironvane Media", "meta": [{"name": "viewport", "content": "width=device-width, initial-scale=1, viewport-fit=cover"}, {"name": "description", "content": "Contratamos a quien piensa en hipótesis y tests. Vacantes en estrategia creativa, performance, analítica, captación y producción."}, {"name": "theme-color", "content": "#060607"}, {"name": "color-scheme", "content": "dark"}, {"name": "robots", "content": "index, follow"}, {"name": "author", "content": "Ironvane Media"}, {"property": "og:type", "content": "website"}, {"property": "og:site_name", "content": "Ironvane Media"}, {"property": "og:title", "content": "Empleo — trabaja en Ironvane Media"}, {"property": "og:description", "content": "Contratamos a quien piensa en hipótesis y tests. Vacantes en estrategia creativa, performance, analítica, captación y producción."}, {"property": "og:url", "content": "https://ironvane-media.com/es/careers/"}, {"property": "og:image", "content": "https://ironvane-media.com/assets/og/es-careers.png"}, {"property": "og:image:width", "content": "1200"}, {"property": "og:image:height", "content": "630"}, {"property": "og:image:alt", "content": "Ironvane Media"}, {"property": "og:locale", "content": "es_ES"}, {"property": "og:locale:alternate", "content": "en_GB"}, {"property": "og:locale:alternate", "content": "ru_RU"}, {"property": "og:locale:alternate", "content": "uk_UA"}, {"property": "og:locale:alternate", "content": "cs_CZ"}, {"name": "twitter:card", "content": "summary_large_image"}, {"name": "twitter:title", "content": "Empleo — trabaja en Ironvane Media"}, {"name": "twitter:description", "content": "Contratamos a quien piensa en hipótesis y tests. Vacantes en estrategia creativa, performance, analítica, captación y producción."}, {"name": "twitter:image", "content": "https://ironvane-media.com/assets/og/es-careers.png"}], "links": [{"rel": "canonical", "href": "https://ironvane-media.com/es/careers/"}, {"rel": "alternate", "href": "https://ironvane-media.com/en/careers/", "hreflang": "en"}, {"rel": "alternate", "href": "https://ironvane-media.com/ru/careers/", "hreflang": "ru"}, {"rel": "alternate", "href": "https://ironvane-media.com/uk/careers/", "hreflang": "uk"}, {"rel": "alternate", "href": "https://ironvane-media.com/es/careers/", "hreflang": "es"}, {"rel": "alternate", "href": "https://ironvane-media.com/cs/careers/", "hreflang": "cs"}, {"rel": "alternate", "href": "https://ironvane-media.com/en/careers/", "hreflang": "x-default"}, {"rel": "alternate", "href": "/es/insights/rss.xml", "type": "application/rss+xml", "title": "Recursos — centro de conocimiento de performance marketing"}], "structuredData": ["{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"¿Cómo es el proceso de selección?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Cinco pasos en unas dos semanas: candidatura, llamada inicial, prueba remunerada, sesión a fondo y decisión. Recibes feedback en cada etapa, también si la respuesta es no.\"}},{\"@type\":\"Question\",\"name\":\"¿Hay prueba técnica?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sí, y está remunerada. Ocupa entre tres y cuatro horas, refleja el trabajo real y conservas los derechos. No usamos las pruebas de candidatos en cuentas de clientes.\"}},{\"@type\":\"Question\",\"name\":\"¿Se puede trabajar en remoto?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"La mayoría de puestos son totalmente remotos dentro de husos horarios europeos compatibles. Algunos son híbridos porque el trabajo requiere tiempo regular con el equipo de cuenta. Se indica en cada vacante.\"}},{\"@type\":\"Question\",\"name\":\"¿Qué experiencia pedís?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Depende del puesto: desde un año para producción hasta cuatro o más para llevar una cuenta. Nos importa más cómo razonas ante una cuenta desordenada que los años del CV.\"}},{\"@type\":\"Question\",\"name\":\"¿Desde qué países contratáis?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Desde cualquier país de Europa y CEI con horario solapado. Los idiomas adicionales — español, checo, polaco, alemán, turco, portugués — amplían de verdad lo que puedes llevar aquí.\"}},{\"@type\":\"Question\",\"name\":\"¿Cómo es el primer mes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Primera semana: medición, herramientas y cuentas. De la segunda a la cuarta, acompañando una cuenta activa con un mentor asignado y después tus primeros tests. Antes de acabar el mes presentarás algo a todo el equipo.\"}}]}", "{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Inicio\",\"item\":\"https://ironvane-media.com/es/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Empleo\",\"item\":\"https://ironvane-media.com/es/careers/\"}]}"]}, "pre": "<div aria-hidden=\"true\" class=\"grain\"></div><svg aria-hidden=\"true\" class=\"viz-defs\" focusable=\"false\" height=\"0\" width=\"0\"><defs>\n<pattern height=\"16\" id=\"vzGrid\" patternunits=\"userSpaceOnUse\" width=\"16\"><path d=\"M16 0H0V16\" fill=\"none\" stroke=\"rgba(242,240,236,0.07)\" stroke-width=\"1\"></path></pattern>\n<lineargradient id=\"mSparkHot\" x1=\"0\" x2=\"0\" y1=\"1\" y2=\"0\"><stop offset=\"0\" stop-color=\"#7b8cff\" stop-opacity=\"0.45\"></stop><stop offset=\"1\" stop-color=\"#a3b0ff\"></stop></lineargradient>\n<lineargradient id=\"mSparkDim\" x1=\"0\" x2=\"0\" y1=\"1\" y2=\"0\"><stop offset=\"0\" stop-color=\"rgba(242,240,236,0.06)\"></stop><stop offset=\"1\" stop-color=\"rgba(242,240,236,0.24)\"></stop></lineargradient>\n<lineargradient gradientunits=\"userSpaceOnUse\" id=\"sparkleGrad\" x1=\"3\" x2=\"21\" y1=\"0\" y2=\"24\"><stop stop-color=\"#ffffff\"></stop><stop offset=\"0.42\" stop-color=\"#cfd4dd\"></stop><stop offset=\"0.68\" stop-color=\"#7f8490\"></stop><stop offset=\"1\" stop-color=