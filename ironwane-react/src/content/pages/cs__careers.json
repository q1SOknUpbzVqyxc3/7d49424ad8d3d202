{"route": "/cs/careers/", "locale": "cs", "seo": {"title": "Kariéra — práce v Ironvane Media", "meta": [{"name": "viewport", "content": "width=device-width, initial-scale=1, viewport-fit=cover"}, {"name": "description", "content": "Bereme lidi, kteří přemýšlejí v hypotézách a testech. Otevřené pozice v kreativní strategii, výkonu, analytice, akvizici a produkci."}, {"name": "theme-color", "content": "#060607"}, {"name": "color-scheme", "content": "dark"}, {"name": "robots", "content": "index, follow"}, {"name": "author", "content": "Ironvane Media"}, {"property": "og:type", "content": "website"}, {"property": "og:site_name", "content": "Ironvane Media"}, {"property": "og:title", "content": "Kariéra — práce v Ironvane Media"}, {"property": "og:description", "content": "Bereme lidi, kteří přemýšlejí v hypotézách a testech. Otevřené pozice v kreativní strategii, výkonu, analytice, akvizici a produkci."}, {"property": "og:url", "content": "https://ironvane-media.com/cs/careers/"}, {"property": "og:image", "content": "https://ironvane-media.com/assets/og/cs-careers.png"}, {"property": "og:image:width", "content": "1200"}, {"property": "og:image:height", "content": "630"}, {"property": "og:image:alt", "content": "Ironvane Media"}, {"property": "og:locale", "content": "cs_CZ"}, {"property": "og:locale:alternate", "content": "en_GB"}, {"property": "og:locale:alternate", "content": "ru_RU"}, {"property": "og:locale:alternate", "content": "uk_UA"}, {"property": "og:locale:alternate", "content": "es_ES"}, {"name": "twitter:card", "content": "summary_large_image"}, {"name": "twitter:title", "content": "Kariéra — práce v Ironvane Media"}, {"name": "twitter:description", "content": "Bereme lidi, kteří přemýšlejí v hypotézách a testech. Otevřené pozice v kreativní strategii, výkonu, analytice, akvizici a produkci."}, {"name": "twitter:image", "content": "https://ironvane-media.com/assets/og/cs-careers.png"}], "links": [{"rel": "canonical", "href": "https://ironvane-media.com/cs/careers/"}, {"rel": "alternate", "href": "https://ironvane-media.com/en/careers/", "hreflang": "en"}, {"rel": "alternate", "href": "https://ironvane-media.com/ru/careers/", "hreflang": "ru"}, {"rel": "alternate", "href": "https://ironvane-media.com/uk/careers/", "hreflang": "uk"}, {"rel": "alternate", "href": "https://ironvane-media.com/es/careers/", "hreflang": "es"}, {"rel": "alternate", "href": "https://ironvane-media.com/cs/careers/", "hreflang": "cs"}, {"rel": "alternate", "href": "https://ironvane-media.com/en/careers/", "hreflang": "x-default"}, {"rel": "alternate", "href": "/cs/insights/rss.xml", "type": "application/rss+xml", "title": "Zdroje — znalostní centrum výkonnostního marketingu"}], "structuredData": ["{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Jak probíhá výběrové řízení?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Pět kroků zhruba za dva týdny: přihláška, úvodní hovor, placené testovací zadání, rozbor a rozhodnutí. Zpětnou vazbu dostanete v každé fázi, i když je odpověď ne.\"}},{\"@type\":\"Question\",\"name\":\"Je součástí testovací zadání?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ano, a je placené. Zabere tři až čtyři hodiny, odpovídá skutečné práci a práva zůstávají vám. Zadání kandidátů nepoužíváme na klientských účtech.\"}},{\"@type\":\"Question\",\"name\":\"Dá se pracovat na dálku?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Většina pozic je plně remote v kompatibilních evropských časových pásmech. Několik rolí je hybridních, protože práce vyžaduje pravidelný čas s týmem účtu. U každé pozice je to uvedeno.\"}},{\"@type\":\"Question\",\"name\":\"Jakou praxi očekáváte?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Podle role: od jednoho roku u produkce po čtyři a více u odpovědnosti za účet. Víc než počet let v životopise nás zajímá, jak uvažujete nad nepřehledným účtem.\"}},{\"@type\":\"Question\",\"name\":\"Ze kterých zemí nabíráte?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Odkudkoli z Evropy a SNS s překrývající se pracovní dobou. Další jazyky — španělština, čeština, polština, němčina, turečtina, portugalština — reálně mění, co u nás můžete vést.\"}},{\"@type\":\"Question\",\"name\":\"Jak vypadá první měsíc?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"První týden: měření, nástroje a účty. Druhý až čtvrtý týden běháte vedle živého účtu s určeným mentorem a pak vedete první vlastní testy. Do konce měsíce něco odprezentujete celému týmu.\"}}]}", "{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Úvod\",\"item\":\"https://ironvane-media.com/cs/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Kariéra\",\"item\":\"https://ironvane-media.com/cs/careers/\"}]}"]}, "pre": "<div aria-hidden=\"true\" class=\"grain\"></div><svg aria-hidden=\"true\" class=\"viz-defs\" focusable=\"false\" height=\"0\" width=\"0\"><defs>\n<pattern height=\"16\" id=\"vzGrid\" patternunits=\"userSpaceOnUse\" width=\"16\"><path d=\"M16 0H0V16\" fill=\"none\" stroke=\"rgba(242,240,236,0.07)\" stroke-width=\"1\"></path></pattern>\n<lineargradient id=\"mSparkHot\" x1=\"0\" x2=\"0\" y1=\"1\" y2=\"0\"><stop offset=\"0\" stop-color=\"#7b8cff\" stop-opacity=\"0.45\"></stop><stop offset=\"1\" stop-color=\"#a3b0ff\"></stop></lineargradient>\n<lineargradient id=\"mSparkDim\" x1=\"0\" x2=\"0\" y1=\"1\" y2=\"0\"><stop offset=\"0\" stop-color=\"rgba(242,240,236,0.06)\"></stop><stop offset=\"1\" stop-color=\"rgba(242,240,236,0.24)\"></stop></lineargradient>\n<lineargradient gradientunits=\"userSpaceOnUse\" id=\"sparkleGrad\" x1=\"3\" x2=\"21\" y1=\"0\" y2=\"24\"><stop stop-color=\"#ffffff\"></stop><stop offset=\"0.42\" stop-color=\"#cfd4dd\"></stop><stop offset=\"0.68\" stop-color=\"#7f8490\"></stop><stop offset=\"1\" stop-color=\"#ffffff\"></stop></lineargradient>\n<symbol id=\"flag-ru\" viewbox=\"0 0 16 12\"><rect fill=\"#fff\" heig