ecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.3\"></path></svg></a><a class=\"menu__ext-link\" href=\"https://teletype.in/@ironvane/Partnership\" hreflang=\"ru\" rel=\"noopener noreferrer\" target=\"_blank\"><span>Partnerství</span><svg aria-hidden=\"true\" fill=\"none\" height=\"12\" viewbox=\"0 0 12 12\" width=\"12\"><path d=\"M3 9L9 3M9 3H4M9 3v5\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.3\"></path></svg></a><a class=\"menu__ext-link\" href=\"https://teletype.in/@ironvane/IronvanePass\" hreflang=\"ru\" rel=\"noopener noreferrer\" target=\"_blank\"><span>Ironvane Pass</span><svg aria-hidden=\"true\" fill=\"none\" height=\"12\" viewbox=\"0 0 12 12\" width=\"12\"><path d=\"M3 9L9 3M9 3H4M9 3v5\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.3\"></path></svg></a></div><div class=\"menu__ext menu__ext--tight\" data-menu-ext=\"\"><span class=\"mono menu__ext-label\">Na Telegramu</span><a class=\"menu__ext-link\" href=\"https://t.me/+-lN8N8R_91UzYjc0\" hreflang=\"ru\" rel=\"noopener noreferrer\" target=\"_blank\"><span>Chat týmu</span><svg aria-hidden=\"true\" fill=\"none\" height=\"12\" viewbox=\"0 0 12 12\" width=\"12\"><path d=\"M3 9L9 3M9 3H4M9 3v5\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.3\"></path></svg></a></div>\n<div class=\"menu__foot\">\n<div class=\"menu__contact\">\n<span class=\"mono\">Jazyk</span>\n<div class=\"menu__langs\"><a aria-current=\"false\" class=\"menu__lang\" data-lang=\"en\" href=\"/en/careers/\" hreflang=\"en\" lang=\"en\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-gb\"></use></svg>EN</a>\n<a aria-current=\"false\" class=\"menu__lang\" data-lang=\"ru\" href=\"/ru/careers/\" hreflang=\"ru\" lang=\"ru\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-ru\"></use></svg>RU</a>\n<a aria-current=\"false\" class=\"menu__lang\" data-lang=\"uk\" href=\"/uk/careers/\" hreflang=\"uk\" lang=\"uk\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-ua\"></use></svg>UK</a>\n<a aria-current=\"false\" class=\"menu__lang\" data-lang=\"es\" href=\"/es/careers/\" hreflang=\"es\" lang=\"es\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-es\"></use></svg>ES</a>\n<a aria-current=\"true\" class=\"menu__lang\" data-lang=\"cs\" href=\"/cs/careers/\" hreflang=\"cs\" lang=\"cs\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-cz\"></use></svg>CS</a></div>\n</div>\n<div class=\"menu__contact\">\n<span class=\"mono\">Obecné dotazy</span>\n<a href=\"mailto:hello@ironvane-media.com\">hello@ironvane-media.com</a>\n</div>\n</div>\n</div>\n</div><div aria-labelledby=\"read-bar-label\" class=\"read-bar\" data-read-bar=\"\" hidden=\"\"><i></i><span class=\"visually-hidden\" id=\"read-bar-label\">Průběh čtení</span></div>", "main": "\n<section class=\"page-hero\">\n<div class=\"container\">\n<nav aria-label=\"Drobečková navigace\" class=\"breadcrumb\" style=\"margin-bottom:24px\"><a href=\"/cs/\">Úvod</a><span aria-hidden=\"true\">/</span><span>Kariéra</span></nav>\n<p class=\"eyebrow\">Kariéra</p>\n<h1 class=\"page-hero__title balance\">Bereme lidi, kteří přemýšlejí v testech.</h1>\n<p class=\"page-hero__lead lead pretty\">Ne ty nejhlasitější ani ty, kdo nejrychleji souhlasí. Hledáme lidi, kteří udrží hypotézu, navrhnou pro ni férový test a změní názor, když to data řeknou.</p>\n</div>\n</section>\n<section class=\"section section--tight ruled\">\n<div class=\"container\">\n<div class=\"section-head\" data-reveal=\"\">\n<p class=\"eyebrow\">Proč tady</p>\n<h2 class=\"h2 balance\">Čím je práce u nás jiná.</h2>\n</div>\n<div class=\"tiles tiles--2\"><div class=\"tile\"><span class=\"tile__num\">01</span><h3 class=\"tile__title\">Odpovídáte za výsledky, ne za tikety</h3><p class=\"tile__text\">Každý má metriku, za kterou odpovídá, a pravomoc měnit způsob, jak s ní hýbat.</p></div>\n<div class=\"tile\"><span class=\"tile__num\">02</span><h3 class=\"tile__title\">Vysoká hustota zkušeností</h3><p class=\"tile__text\">Malé týmy zkušených lidí. Nestrávíte týden vysvětlováním základů ani opravou cizího měření.</p></div>\n<div class=\"tile\"><span class=\"tile__num\">03</span><h3 class=\"tile__title\">Skutečné rozpočty a skutečné trhy</h3><p class=\"tile__text\">Na živých účtech napříč Evropou a SNS pracujete od prvního měsíce — s mentorem, ne podle skriptu.</p></div>\n<div class=\"tile\"><span class=\"tile__num\">04</span><h3 class=\"tile__title\">Učení je v kalendáři, ne v naději</h3><p class=\"tile__text\">Týdenní rozbor toho, co vyšlo a co selhalo, napříč všemi účty. Špatné odpovědi jsou tu užitečné, skryté ne.</p></div></div>\n</div>\n</section>\n<section class=\"section section--line\" id=\"roles\">\n<div class=\"container\">\n<div class=\"section-head\" data-reveal=\"\">\n<p class=\"eyebrow\">Otevřené pozice</p>\n<h2 class=\"h2 balance\">Koho hledáme.</h2>\n<p class=\"lead pretty\">Pokud vám žádná nesedí, ale věříte, že sem patříte, napište nám a řekněte, co byste chtěli mít na starosti.</p>\n</div>\n<div class=\"jobs\" data-reveal=\"\"><div class=\"job\">\n<h3><button aria-controls=\"job-1\" aria-expanded=\"false\" class=\"job__trigger\" data-acc=\"jobs\" type=\"button\">\n<span><span class=\"job__title\">Creative Strategist</span><span class=\"job__sum\">Vlastnit systém sdělení na živých účtech: zkoumat úhly, psát hypotézy a rozhodovat, co se vyrobí dál.</span></span>\n<span class=\"job__tags\"><span class=\"job__tag\">Plný úvazek</span><span class=\"job__tag\">Remote</span><span class=\"job__tag\">Middle+</span></span>\n<span aria-hidden=\"true\" class=\"acc__icon\"></span>\n</button></h3>\n<div class=\"acc__panel\" id=\"job-1\" role=\"region\">\n<div class=\"job__body\">\n<div class=\"service__col\"><span class=\"service__col-key\">Za co odpovídáte</span><ul class=\"tick-list\"><li>Zkoumat publika, recenze, námitky a sdělení konkurence</li>\n<li>Stavět mapy úhlů a měnit je v písemné hypotézy</li>\n<li>Psát produkční zadání s jasnou taxonomií variant</li>\n<li>Číst data o kreativě spolu s analytikem a rozhodovat, co se škáluje</li>\n<li>Vést kalendář únavy, aby obměny vycházely dřív než pokles</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Co očekáváme</span><ul class=\"tick-list\"><li>2+ roky ve výkonnostní kreativě, UA nebo paid social strategii</li>\n<li>Umíte vysvětlit, proč kreativa vyhrála, bez slova „poutavá“</li>\n<li>Data z platforem i kohortní reporty si přečtete sami</li>\n<li>Silná psaná angličtina; druhý evropský jazyk je skutečná výhoda</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Výhodou je</span><ul class=\"tick-list\"><li>Zkušenost s režií UGC</li>\n<li>Práce na více než třech trzích</li>\n<li>Zázemí v copywritingu nebo výzkumu</li></ul></div>\n</div>\n<div class=\"job__actions\"><a class=\"btn btn--primary\" href=\"mailto:careers@ironvane-media.com?subject=Creative%20Strategist%20-%20application\"><span>Přihláška: Creative Strategist</span><svg aria-hidden=\"true\" class=\"btn__icon\" fill=\"none\" height=\"14\" viewbox=\"0 0 14 14\" width=\"14\"><path d=\"M1 7h11M8 3l4 4-4 4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg></a></div>\n</div>\n</div>\n<div class=\"job\">\n<h3><button aria-controls=\"job-2\" aria-expanded=\"false\" class=\"job__trigger\" data-acc=\"jobs\" type=\"button\">\n<span><span class=\"job__title\">Performance Analyst</span><span class=\"job__sum\">Vlastnit vrstvu měření: měření, atribuci a reporty, podle kterých se příští týden pohne rozpočet.</span></span>\n<span class=\"job__tags\"><span class=\"job__tag\">Plný úvazek</span><span class=\"job__tag\">Hybridně</span><span class=\"job__tag\">Middle+</span></span>\n<span aria-hidden=\"true\" class=\"acc__icon\"></span>\n</button></h3>\n<div class=\"acc__panel\" id=\"job-2\" role=\"region\">\n<div class=\"job__body\">\n<div class=\"service__col\"><span class=\"service__col-key\">Za co odpovídáte</span><ul class=\"tick-list\"><li>Navrhovat a kontrolovat schémata událostí na webu i v aplikacích</li>\n<li>Udržovat dohody o atribuci a srovnávat data platforem s interními</li>\n<li>Stavět kohortní, trychtýřovou a návratnostní analýzu podle trhů</li>\n<li>Definovat velikosti vzorků a pravidla ukončení pro testy kreativy</li>\n<li>Měnit analýzu v report s rozhodnutími, ne v prohlídku dashboardu</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Co očekáváme</span><ul class=\"tick-list\"><li>2+ roky v marketingové analytice, BI nebo growth analytice</li>\n<li>SQL je pro vás samozřejmost: kohortní dotaz napíšete bez pomoci</li>\n<li>Atribuci rozumíte natolik, abyste uměli vysvětlit její limity</li>\n<li>Jste ochotni říct senior kolegovi, že jeho oblíbená kampaň nefunguje</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Výhodou je</span><ul class=\"tick-list\"><li>Zkušenost s MMP (AppsFlyer, Adjust, Branch)</li>\n<li>Testy inkrementality nebo geo testy</li>\n<li>Python nebo R pro analýzu</li></ul></div>\n</div>\n<div class=\"job__actions\"><a class=\"btn btn--primary\" href=\"mailto:careers@ironvane-media.com?subject=Performance%20Analyst%20-%20application\"><span>Přihláška: Performance Analyst</span><svg aria-hidden=\"true\" class=\"btn__icon\" fill=\"none\" height=\"14\" viewbox=\"0 0 14 14\" width=\"14\"><path d=\"M1 7h11M8 3l4 4-4 4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg></a></div>\n</div>\n</div>\n<div class=\"job\">\n<h3><button aria-controls=\"job-3\" aria-expanded=\"false\" class=\"job__trigger\" data-acc=\"jobs\" type=\"button\">\n<span><span class=\"job__title\">Media Buyer</span><span class=\"job__sum\">Vést živé rozpočty v Meta, Google a TikTok se strukturou, která dává čistý signál a obhajitelná rozhodnutí.</span></span>\n<span class=\"job__tags\"><span class=\"job__tag\">Plný úvazek</span><span class=\"job__tag\">Remote</span><span class=\"job__tag\">Middle+</span></span>\n<span aria-hidden=\"true\" class=\"acc__icon\"></span>\n</button></h3>\n<div class=\"acc__panel\" id=\"job-3\" role=\"region\">\n<div class=\"job__body\">\n<div class=\"service__col\"><span class=\"service__col-key\">Za co odpovídáte</span><ul class=\"tick-list\"><li>Stavět a udržovat architekturu účtů napříč platformami</li>\n<li>Provádět týdenní optimalizační rutinu a vést záznam rozhodnutí</li>\n<li>Škálovat ověřené buňky kontrolovaným krokem</li>\n<li>Koordinovat rotaci kreativy se strategickým týmem</li>\n<li>Odpovídat za compliance platforem a zdraví účtů</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Co očekáváme</span><ul class=\"tick-list\"><li>2+ roky nákupu médií ve smysluplném měsíčním objemu</li>\n<li>Každou změnu rozpočtu obhájíte důvodem a číslem</li>\n<li>Alespoň jednu velkou platformu ovládáte, v ostatních se orientujete</li>\n<li>Disciplína v pojmenování, struktuře a dokumentaci</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Výhodou je</span><ul class=\"tick-list\"><li>Zkušenost s UA pro aplikace</li>\n<li>Nákup napříč více trhy</li>\n<li>Znalost server-side měření</li></ul></div>\n</div>\n<div class=\"job__actions\"><a class=\"btn btn--primary\" href=\"mailto:careers@ironvane-media.com?subject=Media%20Buyer%20-%20application\"><span>Přihláška: Media Buyer</span><svg aria-hidden=\"true\" class=\"btn__icon\" fill=\"none\" height=\"14\" viewbox=\"0 0 14 14\" width=\"14\"><path d=\"M1 7h11M8 3l4 4-4 4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg></a></div>\n</div>\n</div>\n<div class=\"job\">\n<h3><button aria-controls=\"job-4\" aria-expanded=\"false\" class=\"job__trigger\" data-acc=\"jobs\" type=\"button\">\n<span><span class=\"job__title\">Motion Designer</span><span class=\"job__sum\">Vyrábět výkonnostní video a motion v tempu testování — varianty, které izolují vždy jeden prvek.</span></span>\n<span class=\"job__tags\"><span class=\"job__tag\">Plný úvazek</span><span class=\"job__tag\">Remote</span><span class=\"job__tag\">Junior+</span></span>\n<span aria-hidden=\"true\" class=\"acc__icon\"></span>\n</button></h3>\n<div class=\"acc__panel\" id=\"job-4\" role=\"region\">\n<div class=\"job__body\">\n<div class=\"service__col\"><span class=\"service__col-key\">Za co odpovídáte</span><ul class=\"tick-list\"><li>Vyrábět video, motion a statiku podle písemných zadání</li>\n<li>Systematicky obměňovat hooky, důkazy a závěry uvnitř dávky</li>\n<li>Přizpůsobovat assety nativním formátům a poměrům stran</li>\n<li>Lokalizovat kreativu pro trhy společně se stratégy</li>\n<li>Držet pevný rytmus dodávek se správným značkováním</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Co očekáváme</span><ul class=\"tick-list\"><li>1+ rok výroby kreativy pro paid social</li>\n<li>Jistota v After Effects a moderním střihovém workflow</li>\n<li>Chápete, že o výsledku rozhodují první tři sekundy</li>\n<li>Rychlost, pořádek a klid při větším objemu</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Výhodou je</span><ul class=\"tick-list\"><li>Zkušenost se střihem UGC</li>\n<li>Základní 3D nebo Cinema 4D</li>\n<li>Cit pro sound design</li></ul></div>\n</div>\n<div class=\"job__actions\"><a class=\"btn btn--primary\" href=\"mailto:careers@ironvane-media.com?subject=Motion%20Designer%20-%20application\"><span>Přihláška: Motion Designer</span><svg aria-hidden=\"true\" class=\"btn__icon\" fill=\"none\" height=\"14\" viewbox=\"0 0 14 14\" width=\"14\"><path d=\"M1 7h11M8 3l4 4-4 4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg></a></div>\n</div>\n</div>\n<div class=\"job\">\n<h3><button aria-controls=\"job-5\" aria-expanded=\"false\" class=\"job__trigger\" data-acc=\"jobs\" type=\"button\">\n<span><span class=\"job__title\">Growth / Acquisition Manager</span><span class=\"job__sum\">Vést účet od začátku do konce: cíl, plán, tým kolem něj a číslo, které se vykazuje na konci měsíce.</span></span>\n<span class=\"job__tags\"><span class=\"job__tag\">Plný úvazek</span><span class=\"job__tag\">Hybridně</span><span class=\"job__tag\">Senior</span></span>\n<span aria-hidden=\"true\" class=\"acc__icon\"></span>\n</button></h3>\n<div class=\"acc__panel\" id=\"job-5\" role=\"region\">\n<div class=\"job__body\">\n<div class=\"service__col\"><span class=\"service__col-key\">Za co odpovídáte</span><ul class=\"tick-list\"><li>Odpovídat za cílovou ekonomiku a akviziční plán účtu</li>\n<li>Sladit kreativu, nákup a analytiku do jednoho týdenního rytmu</li>\n<li>Vést komunikaci s klientem důkazy, ne ujišťováním</li>\n<li>Plánovat expanzi fázovanými piloty s kritérii ukončení</li>\n<li>Předpovídat objem a náklad na obhajitelných předpokladech</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Co očekáváme</span><ul class=\"tick-list\"><li>4+ roky ve výkonnostním marketingu, alespoň rok s odpovědností za účet</li>\n<li>S klientem si o jednotkové ekonomice popovídáte bez slidů</li>\n<li>Máte za sebou škálování účtu bez narušení návratnosti</li>\n<li>Plynulá angličtina; ruština, španělština, čeština nebo němčina je výhodou</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Výhodou je</span><ul class=\"tick-list\"><li>Zkušenost z agentury i in-house</li>\n<li>Odpovědnost za P&amp;L na více trzích</li>\n<li>Zkušenost s náborem nebo mentoringem</li></ul></div>\n</div>\n<div class=\"job__actions\"><a class=\"btn btn--primary\" href=\"mailto:careers@ironvane-media.com?subject=Growth%20%2F%20Acquisition%20Manager%20-%20application\"><span>Přihláška: Growth / Acquisition Manager</span><svg aria-hidden=\"true\" class=\"btn__icon\" fill=\"none\" height=\"14\" viewbox=\"0 0 14 14\" width=\"14\"><path d=\"M1 7h11M8 3l4 4-4 4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg></a></div>\n</div>\n</div></div>\n</div>\n</section>\n<section class=\"section section--line\">\n<div class=\"container\">\n<div class=\"section-head\" data-reveal=\"\">\n<p class=\"eyebrow\">Průběh výběru</p>\n<h2 class=\"h2 balance\">Pět kroků, přibližně dva týdny.</h2>\n<p class=\"lead pretty\">V každé fázi dostanete rozhodnutí i zpětnou vazbu — ať už je odpověď ano, nebo ne.</p>\n</div>\n<div class=\"steps\"><div class=\"step\" data-reveal=\"\"><span class=\"step__num\">01</span><h3 class=\"step__title\">Přihláška</h3><p class=\"step__text\">Pošlete krátkou zprávu o tom, co jste vedli a co jste se naučili. Čteme každou — samotný životopis nám obvykle moc neřekne.</p></div>\n<div class=\"step\" data-reveal=\"\"><span class=\"step__num\">02</span><h3 class=\"step__title\">Úvodní hovor</h3><p class=\"step__text\">30 minut s člověkem, který by vaši práci vedl. Poctivá řeč o roli, účtech a očekáváních.</p></div>\n<div class=\"step\" data-reveal=\"\"><span class=\"step__num\">03</span><h3 class=\"step__title\">Testovací zadání</h3><p class=\"step__text\">Krátké placené a realistické zadání, obvykle na 3 až 4 hodiny. Odpovídá skutečné práci a práva k výsledku zůstávají vám.</p></div>\n<div class=\"step\" data-reveal=\"\"><span class=\"step__num\">04</span><h3 class=\"step__title\">Rozbor</h3><p class=\"step__text\">Projdeme vaše zadání společně a pracujeme na živém problému. Tady zjistíme, jak přemýšlíte, když jsou data neuklizená.</p></div>\n<div class=\"step\" data-reveal=\"\"><span class=\"step__num\">05</span><h3 class=\"step__title\">Nabídka</h3><p class=\"step__text\">Rozhodnutí a písemná zpětná vazba do tří dnů od rozboru, ať je odpověď jakákoli.</p></div></div>\n</div>\n</section>\n<section class=\"section section--line\">\n<div class=\"container\">\n<div class=\"section-head\" data-reveal=\"\">\n<p class=\"eyebrow\">Otázky</p>\n<h2 class=\"h2 balance\">Než se přihlásíte.</h2>\n</div>\n<div class=\"accordion\" data-reveal=\"\">\n<div class=\"acc\">\n<h3><button aria-controls=\"careers-faq-1\" aria-expanded=\"false\" class=\"acc__trigger\" data-acc=\"exclusive\" type=\"button\"><span class=\"acc__q\"><span class=\"num\">01</span><span>Jak probíhá výběrové řízení?</span></span><span aria-hidden=\"true\" class=\"acc__icon\"></span></button></h3>\n<div class=\"acc__panel\" id=\"careers-faq-1\" role=\"region\"><div class=\"acc__body\"><p>Pět kroků zhruba za dva týdny: přihláška, úvodní hovor, placené testovací zadání, rozbor a rozhodnutí. Zpětnou vazbu dostanete v každé fázi, i když je odpověď ne.</p></div></div>\n</div>\n<div class=\"acc\">\n<h3><button aria-controls=\"careers-faq-2\" aria-expanded=\"false\" class=\"acc__trigger\" data-acc=\"exclusive\" type=\"button\"><span class=\"acc__q\"><span class=\"num\">02</span><span>Je součástí testovací zadání?</span></span><span aria-hidden=\"true\" class=\"acc__icon\"></span></button></h3>\n<div class=\"acc__panel\" id=\"careers-faq-2\" role=\"region\"><div class=\"acc__body\"><p>Ano, a je placené. Zabere tři až čtyři hodiny, odpovídá skutečné práci a práva zůstávají vám. Zadání kandidátů nepoužíváme na klientských účtech.</p></div></div>\n</div>\n<div class=\"acc\">\n<h3><button aria-controls=\"careers-faq-3\" aria-expanded=\"false\" class=\"acc__trigger\" data-acc=\"exclusive\" type=\"button\"><span class=\"acc__q\"><span class=\"num\">03</span><span>Dá se pracovat na dálku?</span></span><span aria-hidden=\"true\" class=\"acc__icon\"></span></button></h3>\n<div class=\"acc__panel\" id=\"careers-faq-3\" role=\"region\"><div class=\"acc__body\"><p>Většina pozic je plně remote v kompatibilních evropských časových pásmech. Několik rolí je hybridních, protože práce vyžaduje pravidelný čas s týmem účtu. U každé pozice je to uvedeno.</p></div></div>\n</div>\n<div class=\"acc\">\n<h3><button aria-controls=\"careers-faq-4\" aria-expanded=\"false\" class=\"acc__trigger\" data-acc=\"exclusive\" type=\"button\"><span class=\"acc__q\"><span class=\"num\">04</span><span>Jakou praxi očekáváte?</span></span><span aria-hidden=\"true\" class=\"acc__icon\"></span></button></h3>\n<div class=\"acc__panel\" id=\"careers-faq-4\" role=\"region\"><div class=\"acc__body\"><p>Podle role: od jednoho roku u produkce po čtyři a více u odpovědnosti za účet. Víc než počet let v životopise nás zajímá, jak uvažujete nad nepřehledným účtem.</p></div></div>\n</div>\n<div class=\"acc\">\n<h3><button aria-controls=\"careers-faq-5\" aria-expanded=\"false\" class=\"acc__trigger\" data-acc=\"exclusive\" type=\"button\"><span class=\"acc__q\"><span class=\"num\">05</span><span>Ze kterých zemí nabíráte?</span></span><span aria-hidden=\"true\" class=\"acc__icon\"></span></button></h3>\n<div class=\"acc__panel\" id=\"careers-faq-5\" role=\"region\"><div class=\"acc__body\"><p>Odkudkoli z Evropy a SNS s překrývající se pracovní dobou. Další jazyky — španělština, čeština, polština, němčina, turečtina, portugalština — reálně mění, co u nás můžete vést.</p></div></div>\n</div>\n<div class=\"acc\">\n<h3><button aria-controls=\"careers-faq-6\" aria-expanded=\"false\" class=\"acc__trigger\" data-acc=\"exclusive\" type=\"button\"><span class=\"acc__q\"><span class=\"num\">06</span><span>Jak vypadá první měsíc?</span></span><span aria-hidden=\"true\" class=\"acc__icon\"></span></button></h3>\n<div class=\"acc__panel\" id=\"careers-faq-6\" role=\"region\"><div class=\"acc__body\"><p>První týden: měření, nástroje a účty. Druhý až čtvrtý týden běháte vedle živého účtu s určeným mentorem a pak vedete první vlastní testy. Do konce měsíce něco odprezentujete celému týmu.</p></div></div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"cta-band\">\n<svg aria-hidden=\"true\" class=\"sparkle cta-band__spark\" fill=\"none\" focusable=\"false\" height=\"34\" viewbox=\"0 0 24 24\" width=\"34\"><path d=\"M12 0c0 6.627 5.373 12 12 12-6.627 0-12 5.373-12 12 0-6.627-5.373-12-12-12C6.627 12 12 6.627 12 0Z\" fill=\"url(#sparkleGrad)\"></path></svg><svg aria-hidden=\"true\" class=\"sparkle sparkle--sm cta-band__spark cta-band__spark--b\" fill=\"none\" focusable=\"false\" height=\"18\" viewbox=\"0 0 24 24\" width=\"18\"><path d=\"M12 0c0 6.627 5.373 12 12 12-6.627 0-12 5.373-12 12 0-6.627-5.373-12-12-12C6.627 12 12 6.627 12 0Z\" fill=\"url(#sparkleGrad)\"></path></svg>\n<div class=\"container\">\n<div class=\"cta-band__inner\" data-reveal=\"\">\n<h2 class=\"cta-band__title balance\">Myslíte, že sem patříte?</h2>\n<p class=\"cta-band__lead pretty\">Pošlete krátkou zprávu o tom, co jste vedli, co jste se naučili a co chcete mít na starosti dál. Životopis pomůže, ale zpráva váží víc.</p>\n<div class=\"cta-band__actions\"><a class=\"btn btn--primary\" href=\"mailto:careers@ironvane-media.com\"><span>Poslat přihlášku</span><svg aria-hidden=\"true\" class=\"btn__icon\" fill=\"none\" height=\"14\" viewbox=\"0 0 14 14\" width=\"14\"><path d=\"M1 7h11M8 3l4 4-4 4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg></a></div>\n</div>\n</div>\n</section>\n", "footer": "\n<div class=\"container\">\n<div class=\"footer__top\">\n<div class=\"footer__brand\">\n<a aria-label=\"Ironvane Media\" class=\"logo\" href=\"/cs/\">\n<svg aria-hidden=\"true\" class=\"logo__mark\" fill=\"none\" height=\"22\" viewbox=\"0 0 24 24\" width=\"22\"><defs><lineargradient gradientunits=\"userSpaceOnUse\" id=\"ivmMarkf\" x1=\"4\" x2=\"20\" y1=\"0\" y2=\"24\"><stop stop-color=\"#ffffff\"></stop><stop offset=\"0.45\" stop-color=\"#c9ccd2\"></stop><stop offset=\"0.7\" stop-color=\"#82868f\"></stop><stop offset=\"1\" stop-color=\"#ffffff\"></stop></lineargradient></defs><path d=\"M12 0c0 6.627 5.373 12 12 12-6.627 0-12 5.373-12 12 0-6.6