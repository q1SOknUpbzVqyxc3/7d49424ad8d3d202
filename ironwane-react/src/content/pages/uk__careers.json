den=\"true\" fill=\"none\" height=\"12\" viewbox=\"0 0 12 12\" width=\"12\"><path d=\"M3 9L9 3M9 3H4M9 3v5\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.3\"></path></svg></a><a class=\"menu__ext-link\" href=\"https://teletype.in/@ironvane/Partnership\" hreflang=\"ru\" rel=\"noopener noreferrer\" target=\"_blank\"><span>Партнерство</span><svg aria-hidden=\"true\" fill=\"none\" height=\"12\" viewbox=\"0 0 12 12\" width=\"12\"><path d=\"M3 9L9 3M9 3H4M9 3v5\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.3\"></path></svg></a><a class=\"menu__ext-link\" href=\"https://teletype.in/@ironvane/IronvanePass\" hreflang=\"ru\" rel=\"noopener noreferrer\" target=\"_blank\"><span>Ironvane Pass</span><svg aria-hidden=\"true\" fill=\"none\" height=\"12\" viewbox=\"0 0 12 12\" width=\"12\"><path d=\"M3 9L9 3M9 3H4M9 3v5\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.3\"></path></svg></a></div><div class=\"menu__ext menu__ext--tight\" data-menu-ext=\"\"><span class=\"mono menu__ext-label\">Ми в Telegram</span><a class=\"menu__ext-link\" href=\"https://t.me/+-lN8N8R_91UzYjc0\" hreflang=\"ru\" rel=\"noopener noreferrer\" target=\"_blank\"><span>Чат команди</span><svg aria-hidden=\"true\" fill=\"none\" height=\"12\" viewbox=\"0 0 12 12\" width=\"12\"><path d=\"M3 9L9 3M9 3H4M9 3v5\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.3\"></path></svg></a></div>\n<div class=\"menu__foot\">\n<div class=\"menu__contact\">\n<span class=\"mono\">Мова</span>\n<div class=\"menu__langs\"><a aria-current=\"false\" class=\"menu__lang\" data-lang=\"en\" href=\"/en/careers/\" hreflang=\"en\" lang=\"en\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-gb\"></use></svg>EN</a>\n<a aria-current=\"false\" class=\"menu__lang\" data-lang=\"ru\" href=\"/ru/careers/\" hreflang=\"ru\" lang=\"ru\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-ru\"></use></svg>RU</a>\n<a aria-current=\"true\" class=\"menu__lang\" data-lang=\"uk\" href=\"/uk/careers/\" hreflang=\"uk\" lang=\"uk\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-ua\"></use></svg>UK</a>\n<a aria-current=\"false\" class=\"menu__lang\" data-lang=\"es\" href=\"/es/careers/\" hreflang=\"es\" lang=\"es\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-es\"></use></svg>ES</a>\n<a aria-current=\"false\" class=\"menu__lang\" data-lang=\"cs\" href=\"/cs/careers/\" hreflang=\"cs\" lang=\"cs\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-cz\"></use></svg>CS</a></div>\n</div>\n<div class=\"menu__contact\">\n<span class=\"mono\">Загальні питання</span>\n<a href=\"mailto:hello@ironvane-media.com\">hello@ironvane-media.com</a>\n</div>\n</div>\n</div>\n</div><div aria-labelledby=\"read-bar-label\" class=\"read-bar\" data-read-bar=\"\" hidden=\"\"><i></i><span class=\"visually-hidden\" id=\"read-bar-label\">Прогрес читання</span></div>", "main": "\n<section class=\"page-hero\">\n<div class=\"container\">\n<nav aria-label=\"Навігаційний ланцюжок\" class=\"breadcrumb\" style=\"margin-bottom:24px\"><a href=\"/uk/\">Головна</a><span aria-hidden=\"true\">/</span><span>Кар'єра</span></nav>\n<p class=\"eyebrow\">Кар'єра</p>\n<h1 class=\"page-hero__title balance\">Ми беремо тих, хто мислить тестами.</h1>\n<p class=\"page-hero__lead lead pretty\">Не найгучніших і не тих, хто швидше за всіх погоджується. Нам потрібні люди, які вміють тримати гіпотезу, вигадати для неї чесний тест і змінити думку, коли дані кажуть протилежне.</p>\n</div>\n</section>\n<section class=\"section section--tight ruled\">\n<div class=\"container\">\n<div class=\"section-head\" data-reveal=\"\">\n<p class=\"eyebrow\">Чому тут</p>\n<h2 class=\"h2 balance\">Чим робота в нас відрізняється.</h2>\n</div>\n<div class=\"tiles tiles--2\"><div class=\"tile\"><span class=\"tile__num\">01</span><h3 class=\"tile__title\">Ви відповідаєте за результат, а не за задачі</h3><p class=\"tile__text\">У кожного є метрика, за яку він відповідає, і повноваження змінювати те, як її рухати.</p></div>\n<div class=\"tile\"><span class=\"tile__num\">02</span><h3 class=\"tile__title\">Висока щільність досвіду</h3><p class=\"tile__text\">Невеликі команди із сильних людей. Ви не витрачатимете тиждень на пояснення бази чи полагодження чужого трекінгу.</p></div>\n<div class=\"tile\"><span class=\"tile__num\">03</span><h3 class=\"tile__title\">Живі бюджети і справжні ринки</h3><p class=\"tile__text\">Ви працюєте на реальних акаунтах по Європі та СНД із першого місяця — з наставником, а не за скриптом.</p></div>\n<div class=\"tile\"><span class=\"tile__num\">04</span><h3 class=\"tile__title\">Навчання за розкладом, а не за залишковим принципом</h3><p class=\"tile__text\">Щотижневий розбір того, що спрацювало і що провалилося, по всіх акаунтах. Неправильні відповіді тут корисні, приховані — ні.</p></div></div>\n</div>\n</section>\n<section class=\"section section--line\" id=\"roles\">\n<div class=\"container\">\n<div class=\"section-head\" data-reveal=\"\">\n<p class=\"eyebrow\">Відкриті позиції</p>\n<h2 class=\"h2 balance\">Кого ми шукаємо.</h2>\n<p class=\"lead pretty\">Якщо жодна позиція не підходить, але ви впевнені, що вам до нас, — напишіть і розкажіть, що готові взяти на себе.</p>\n</div>\n<div class=\"jobs\" data-reveal=\"\"><div class=\"job\">\n<h3><button aria-controls=\"job-1\" aria-expanded=\"false\" class=\"job__trigger\" data-acc=\"jobs\" type=\"button\">\n<span><span class=\"job__title\">Креативний стратег</span><span class=\"job__sum\">Володіти системою повідомлень на живих акаунтах: досліджувати кути, формулювати гіпотези і вирішувати, що виробляти далі.</span></span>\n<span class=\"job__tags\"><span class=\"job__tag\">Повна зайнятість</span><span class=\"job__tag\">Віддалено</span><span class=\"job__tag\">Middle+</span></span>\n<span aria-hidden=\"true\" class=\"acc__icon\"></span>\n</button></h3>\n<div class=\"acc__panel\" id=\"job-1\" role=\"region\">\n<div class=\"job__body\">\n<div class=\"service__col\"><span class=\"service__col-key\">За що відповідаєте</span><ul class=\"tick-list\"><li>Досліджувати аудиторію, відгуки, заперечення і повідомлення конкурентів</li>\n<li>Будувати карти кутів і перетворювати їх на письмові гіпотези</li>\n<li>Писати продакшн-брифи зі зрозумілою таксономією варіацій</li>\n<li>Читати дані з креативу разом з аналітиком і вирішувати, що масштабувати</li>\n<li>Вести календар вигорання, щоб оновлення виходили до просідання</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Що ми очікуємо</span><ul class=\"tick-list\"><li>Від 2 років у перформанс-креативі, UA або стратегії paid social</li>\n<li>Ви можете пояснити, чому креатив переміг, не вживаючи слова «чіпляючий»</li>\n<li>Спокійно читаєте дані платформ і когортні звіти самі</li>\n<li>Сильна письмова англійська; друга європейська мова — реальна перевага</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Буде плюсом</span><ul class=\"tick-list\"><li>Досвід режисури UGC</li>\n<li>Робота більш ніж на трьох ринках</li>\n<li>Бекграунд у копірайтингу або дослідженнях</li></ul></div>\n</div>\n<div class=\"job__actions\"><a class=\"btn btn--primary\" href=\"mailto:careers@ironvane-media.com?subject=%D0%9A%D1%80%D0%B5%D0%B0%D1%82%D0%B8%D0%B2%D0%BD%D0%B8%D0%B9%20%D1%81%D1%82%D1%80%D0%B0%D1%82%D0%B5%D0%B3%20-%20application\"><span>Відгукнутися: Креативний стратег</span><svg aria-hidden=\"true\" class=\"btn__icon\" fill=\"none\" height=\"14\" viewbox=\"0 0 14 14\" width=\"14\"><path d=\"M1 7h11M8 3l4 4-4 4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg></a></div>\n</div>\n</div>\n<div class=\"job\">\n<h3><button aria-controls=\"job-2\" aria-expanded=\"false\" class=\"job__trigger\" data-acc=\"jobs\" type=\"button\">\n<span><span class=\"job__title\">Performance-аналітик</span><span class=\"job__sum\">Володіти шаром вимірювання: трекінг, атрибуція і звіти, за якими наступного тижня рухається бюджет.</span></span>\n<span class=\"job__tags\"><span class=\"job__tag\">Повна зайнятість</span><span class=\"job__tag\">Гібрид</span><span class=\"job__tag\">Middle+</span></span>\n<span aria-hidden=\"true\" class=\"acc__icon\"></span>\n</button></h3>\n<div class=\"acc__panel\" id=\"job-2\" role=\"region\">\n<div class=\"job__body\">\n<div class=\"service__col\"><span class=\"service__col-key\">За що відповідаєте</span><ul class=\"tick-list\"><li>Проєктувати і перевіряти схеми подій у вебі та застосунках</li>\n<li>Підтримувати угоди про атрибуцію і звіряти дані платформ із внутрішніми</li>\n<li>Будувати когортний, воронковий аналіз і аналіз окупності за ринками</li>\n<li>Визначати розміри вибірок і правила зупинки для тестів креативу</li>\n<li>Перетворювати аналіз на звіт із рішеннями, а не на екскурсію дашбордом</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Що ми очікуємо</span><ul class=\"tick-list\"><li>Від 2 років у маркетинговій аналітиці, BI або growth-аналітиці</li>\n<li>SQL на автоматі: когортний запит пишете без підказок</li>\n<li>Розумієте атрибуцію достатньо, щоб пояснити її обмеження</li>\n<li>Готові сказати senior-колезі, що його улюблена кампанія не працює</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Буде плюсом</span><ul class=\"tick-list\"><li>Досвід з MMP (AppsFlyer, Adjust, Branch)</li>\n<li>Інкрементальність або гео-тести</li>\n<li>Python або R для аналізу</li></ul></div>\n</div>\n<div class=\"job__actions\"><a class=\"btn btn--primary\" href=\"mailto:careers@ironvane-media.com?subject=Performance-%D0%B0%D0%BD%D0%B0%D0%BB%D1%96%D1%82%D0%B8%D0%BA%20-%20application\"><span>Відгукнутися: Performance-аналітик</span><svg aria-hidden=\"true\" class=\"btn__icon\" fill=\"none\" height=\"14\" viewbox=\"0 0 14 14\" width=\"14\"><path d=\"M1 7h11M8 3l4 4-4 4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg></a></div>\n</div>\n</div>\n<div class=\"job\">\n<h3><button aria-controls=\"job-3\" aria-expanded=\"false\" class=\"job__trigger\" data-acc=\"jobs\" type=\"button\">\n<span><span class=\"job__title\">Медіабаєр</span><span class=\"job__sum\">Вести живі бюджети в Meta, Google і TikTok зі структурою, яка дає чистий сигнал і захищувані рішення.</span></span>\n<span class=\"job__tags\"><span class=\"job__tag\">Повна зайнятість</span><span class=\"job__tag\">Віддалено</span><span class=\"job__tag\">Middle+</span></span>\n<span aria-hidden=\"true\" class=\"acc__icon\"></span>\n</button></h3>\n<div class=\"acc__panel\" id=\"job-3\" role=\"region\">\n<div class=\"job__body\">\n<div class=\"service__col\"><span class=\"service__col-key\">За що відповідаєте</span><ul class=\"tick-list\"><li>Будувати і підтримувати архітектуру акаунтів на всіх платформах</li>\n<li>Виконувати щотижневий цикл оптимізації і вести журнал рішень</li>\n<li>Масштабувати підтверджені комірки контрольованим кроком</li>\n<li>Узгоджувати ротацію креативу зі стратегічною командою</li>\n<li>Відповідати за комплаєнс платформ і здоров'я акаунтів</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Що ми очікуємо</span><ul class=\"tick-list\"><li>Від 2 років закупівлі на помітних місячних обсягах</li>\n<li>Кожну зміну бюджету можете обґрунтувати причиною і цифрою</li>\n<li>Вільно володієте хоча б однією великою платформою і орієнтуєтеся в решті</li>\n<li>Дисципліновані в неймінгу, структурі й документації</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Буде плюсом</span><ul class=\"tick-list\"><li>Досвід UA для застосунків</li>\n<li>Закупівля на кількох ринках</li>\n<li>Знайомство із серверним трекінгом</li></ul></div>\n</div>\n<div class=\"job__actions\"><a class=\"btn btn--primary\" href=\"mailto:careers@ironvane-media.com?subject=%D0%9C%D0%B5%D0%B4%D1%96%D0%B0%D0%B1%D0%B0%D1%94%D1%80%20-%20application\"><span>Відгукнутися: Медіабаєр</span><svg aria-hidden=\"true\" class=\"btn__icon\" fill=\"none\" height=\"14\" viewbox=\"0 0 14 14\" width=\"14\"><path d=\"M1 7h11M8 3l4 4-4 4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg></a></div>\n</div>\n</div>\n<div class=\"job\">\n<h3><button aria-controls=\"job-4\" aria-expanded=\"false\" class=\"job__trigger\" data-acc=\"jobs\" type=\"button\">\n<span><span class=\"job__title\">Моушн-дизайнер</span><span class=\"job__sum\">Виробляти перформанс-відео і моушн зі швидкістю тестування — варіації, які ізолюють один елемент за раз.</span></span>\n<span class=\"job__tags\"><span class=\"job__tag\">Повна зайнятість</span><span class=\"job__tag\">Віддалено</span><span class=\"job__tag\">Junior+</span></span>\n<span aria-hidden=\"true\" class=\"acc__icon\"></span>\n</button></h3>\n<div class=\"acc__panel\" id=\"job-4\" role=\"region\">\n<div class=\"job__body\">\n<div class=\"service__col\"><span class=\"service__col-key\">За що відповідаєте</span><ul class=\"tick-list\"><li>Виробляти відео, моушн і статику за письмовими брифами</li>\n<li>Системно варіювати хуки, докази і фінали всередині партії</li>\n<li>Адаптувати асети під нативні формати і співвідношення сторін</li>\n<li>Локалізувати креатив під ринки разом зі стратегами</li>\n<li>Тримати фіксований ритм здачі з коректним теґуванням</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Що ми очікуємо</span><ul class=\"tick-list\"><li>Від 1 року виробництва креативу для paid social</li>\n<li>Впевнено працюєте в After Effects і сучасному монтажному пайплайні</li>\n<li>Розумієте, що перші три секунди вирішують результат</li>\n<li>Швидко, організовано і спокійно ставитеся до обсягу</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Буде плюсом</span><ul class=\"tick-list\"><li>Досвід монтажу UGC</li>\n<li>Базовий 3D або Cinema 4D</li>\n<li>Відчуття саунд-дизайну</li></ul></div>\n</div>\n<div class=\"job__actions\"><a class=\"btn btn--primary\" href=\"mailto:careers@ironvane-media.com?subject=%D0%9C%D0%BE%D1%83%D1%88%D0%BD-%D0%B4%D0%B8%D0%B7%D0%B0%D0%B9%D0%BD%D0%B5%D1%80%20-%20application\"><span>Відгукнутися: Моушн-дизайнер</span><svg aria-hidden=\"true\" class=\"btn__icon\" fill=\"none\" height=\"14\" viewbox=\"0 0 14 14\" width=\"14\"><path d=\"M1 7h11M8 3l4 4-4 4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg></a></div>\n</div>\n</div>\n<div class=\"job\">\n<h3><button aria-controls=\"job-5\" aria-expanded=\"false\" class=\"job__trigger\" data-acc=\"jobs\" type=\"button\">\n<span><span class=\"job__title\">Growth / Acquisition Manager</span><span class=\"job__sum\">Вести акаунт цілком: ціль, план, команда навколо нього і цифра, яку ви показуєте наприкінці місяця.</span></span>\n<span class=\"job__tags\"><span class=\"job__tag\">Повна зайнятість</span><span class=\"job__tag\">Гібрид</span><span class=\"job__tag\">Senior</span></span>\n<span aria-hidden=\"true\" class=\"acc__icon\"></span>\n</button></h3>\n<div class=\"acc__panel\" id=\"job-5\" role=\"region\">\n<div class=\"job__body\">\n<div class=\"service__col\"><span class=\"service__col-key\">За що відповідаєте</span><ul class=\"tick-list\"><li>Відповідати за цільову економіку і дорожню карту залучення по акаунту</li>\n<li>Зводити креатив, закупівлю й аналітику в один тижневий ритм</li>\n<li>Вести комунікацію з клієнтом доказами, а не запевненнями</li>\n<li>Планувати вихід на ринки поетапними пілотами з критеріями зупинки</li>\n<li>Прогнозувати обсяг і вартість на захищуваних припущеннях</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Що ми очікуємо</span><ul class=\"tick-list\"><li>Від 4 років у перформанс-маркетингу, мінімум рік — із повною відповідальністю за акаунт</li>\n<li>Можете обговорювати юніт-економіку з клієнтом без слайдів</li>\n<li>Є досвід масштабування акаунта без зламу окупності</li>\n<li>Вільна англійська; російська, іспанська, чеська або німецька — перевага</li></ul></div>\n<div class=\"service__col\"><span class=\"service__col-key\">Буде плюсом</span><ul class=\"tick-list\"><li>Досвід і в агенції, і в ін-хаусі</li>\n<li>Відповідальність за P&amp;L на кількох ринках</li>\n<li>Досвід найму або менторства</li></ul></div>\n</div>\n<div class=\"job__actions\"><a class=\"btn btn--primary\" href=\"mailto:careers@ironvane-media.com?subject=Growth%20%2F%20Acquisition%20Manager%20-%20application\"><span>Відгукнутися: Growth / Acquisition Manager</span><svg aria-hidden=\"true\" class=\"btn__icon\" fill=\"none\" height=\"14\" viewbox=\"0 0 14 14\" width=\"14\"><path d=\"M1 7h11M8 3l4 4-4 4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg></a></div>\n</div>\n</div></div>\n</div>\n</section>\n<section class=\"section section--line\">\n<div class=\"container\">\n<div class=\"section-head\" data-reveal=\"\">\n<p class=\"eyebrow\">Процес найму</p>\n<h2 class=\"h2 balance\">П'ять кроків, приблизно два тижні.</h2>\n<p class=\"lead pretty\">На кожному етапі ви отримуєте рішення і зворотний зв'язок — незалежно від того, позитивне воно чи ні.</p>\n</div>\n<div class=\"steps\"><div class=\"step\" data-reveal=\"\"><span class=\"step__num\">01</span><h3 class=\"step__title\">Відгук</h3><p class=\"step__text\">Надішліть короткий лист про те, що ви вели і чого навчилися. Ми читаємо кожен — одного резюме зазвичай недостатньо, щоб щось зрозуміти.</p></div>\n<div class=\"step\" data-reveal=\"\"><span class=\"step__num\">02</span><h3 class=\"step__title\">Знайомство</h3><p class=\"step__text\">30 хвилин із людиною, яка вестиме вашу роботу. Чесна розмова про роль, акаунти й очікування.</p></div>\n<div class=\"step\" data-reveal=\"\"><span class=\"step__num\">03</span><h3 class=\"step__title\">Тестове завдання</h3><p class=\"step__text\">Коротке оплачуване завдання, зазвичай на 3–4 години. Воно відображає реальну роботу, і права на результат залишаються у вас.</p></div>\n<div class=\"step\" data-reveal=\"\"><span class=\"step__num\">04</span><h3 class=\"step__title\">Розбір</h3><p class=\"step__text\">Розбираємо ваше завдання разом і працюємо над живою задачею. Тут ми бачимо, як ви думаєте, коли дані брудні.</p></div>\n<div class=\"step\" data-reveal=\"\"><span class=\"step__num\">05</span><h3 class=\"step__title\">Офер</h3><p class=\"step__text\">Рішення і письмовий зворотний зв'язок протягом трьох днів після розбору — незалежно від відповіді.</p></div></div>\n</div>\n</section>\n<section class=\"section section--line\">\n<div class=\"container\">\n<div class=\"section-head\" data-reveal=\"\">\n<p class=\"eyebrow\">Питання</p>\n<h2 class=\"h2 balance\">Перед відгуком.</h2>\n</div>\n<div class=\"accordion\" data-reveal=\"\">\n<div class=\"acc\">\n<h3><button aria-controls=\"careers-faq-1\" aria-expanded=\"false\" class=\"acc__trigger\" data-acc=\"exclusive\" type=\"button\"><span class=\"acc__q\"><span class=\"num\">01</span><span>Як проходить співбесіда?</span></span><span aria-hidden=\"true\" class=\"acc__icon\"></span></button></h3>\n<div class=\"acc__panel\" id=\"careers-faq-1\" role=\"region\"><div class=\"acc__body\"><p>П'ять кроків приблизно за два тижні: відгук, знайомство, оплачуване тестове, розбір, рішення. Зворотний зв'язок ви отримуєте на кожному етапі, зокрема й при відмові.</p></div></div>\n</div>\n<div class=\"acc\">\n<h3><button aria-controls=\"careers-faq-2\" aria-expanded=\"false\" class=\"acc__trigger\" data-acc=\"exclusive\" type=\"button\"><span class=\"acc__q\"><span class=\"num\">02</span><span>Чи є тестове завдання?</span></span><span aria-hidden=\"true\" class=\"acc__icon\"></span></button></h3>\n<div class=\"acc__panel\" id=\"careers-faq-2\" role=\"region\"><div class=\"acc__body\"><p>Так, і воно оплачується. Займає три-чотири години, відображає реальну роботу, права залишаються у вас. Тестові кандидатів ми не використовуємо на клієнтських акаунтах.</p></div></div>\n</div>\n<div class=\"acc\">\n<h3><button aria-controls=\"careers-faq-3\" aria-expanded=\"false\" class=\"acc__trigger\" data-acc=\"exclusive\" type=\"button\"><span class=\"acc__q\"><span class=\"num\">03</span><span>Чи можна працювати віддалено?</span></span><span aria-hidden=\"true\" class=\"acc__icon\"></span></button></h3>\n<div class=\"acc__panel\" id=\"careers-faq-3\" role=\"region\"><div class=\"acc__body\"><p>Більшість позицій — повністю віддалені в сумісних європейських часових поясах. Кілька ролей гібридні, де робота потребує регулярного часу з командою акаунта. Формат зазначено в кожній вакансії.</p></div></div>\n</div>\n<div class=\"acc\">\n<h3><button aria-controls=\"careers-faq-4\" aria-expanded=\"false\" class=\"acc__trigger\" data-acc=\"exclusive\" type=\"button\"><span class=\"acc__q\"><span class=\"num\">04</span><span>Які вимоги до досвіду?</span></span><span aria-hidden=\"true\" class=\"acc__icon\"></span></button></h3>\n<div class=\"acc__panel\" id=\"careers-faq-4\" role=\"region\"><div class=\"acc__body\"><p>Залежить від ролі: від року для продакшну до чотирьох і більше для володіння акаунтом. Нам важливіше, як ви міркуєте в заплутаному акаунті, ніж кількість років у резюме.</p></div></div>\n</div>\n<div class=\"acc\">\n<h3><button aria-controls=\"careers-faq-5\" aria-expanded=\"false\" class=\"acc__trigger\" data-acc=\"exclusive\" type=\"button\"><span class=\"acc__q\"><span class=\"num\">05</span><span>З яких країн ви наймаєте?</span></span><span aria-hidden=\"true\" class=\"acc__icon\"></span></button></h3>\n<div class=\"acc__panel\" id=\"careers-faq-5\" role=\"region\"><div class=\"acc__body\"><p>З будь-якої країни Європи та СНД із перетинними робочими годинами. Додаткові мови — іспанська, чеська, польська, німецька, турецька, португальська — реально розширюють те, що ви можете вести.</p></div></div>\n</div>\n<div class=\"acc\">\n<h3><button aria-controls=\"careers-faq-6\" aria-expanded=\"false\" class=\"acc__trigger\" data-acc=\"exclusive\" type=\"button\"><span class=\"acc__q\"><span class=\"num\">06</span><span>Як проходить перший місяць?</span></span><span aria-hidden=\"true\" class=\"acc__icon\"></span></button></h3>\n<div class=\"acc__panel\" id=\"careers-faq-6\" role=\"region\"><div class=\"acc__body\"><p>Перший тиждень: вимірювання, інструменти й акаунти. З другого по четвертий — робота поруч із живим акаунтом і призначеним наставником, потім ваші перші тести. До кінця місяця ви щось презентуєте всій команді.</p></div></div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"cta-band\">\n<svg aria-hidden=\"true\" class=\"sparkle cta-band__spark\" fill=\"none\" focusable=\"false\" height=\"34\" viewbox=\"0 0 24 24\" width=\"34\"><path d=\"M12 0c0 6.627 5.373 12 12 12-6.627 0-12 5.373-12 12 0-6.627-5.373-12-12-12C6.627 12 12 6.627 12 0Z\" fill=\"url(#sparkleGrad)\"></path></svg><svg aria-hidden=\"true\" class=\"sparkle sparkle--sm cta-band__spark cta-band__spark--b\" fill=\"none\" focusable=\"false\" height=\"18\" viewbox=\"0 0 24 24\" width=\"18\"><path d=\"M12 0c0 6.627 5.373 12 12 12-6.627 0-12 5.373-12 12 0-6.627-5.373-12-12-12C6.627 12 12 6.627 12 0Z\" fill=\"url(#sparkleGrad)\"></path></svg>\n<div class=\"container\">\n<div class=\"cta-band__inner\" data-reveal=\"\">\n<h2 class=\"cta-band__title balance\">Вважаєте, що вам до нас?</h2>\n<p class=\"cta-band__lead pretty\">Надішліть короткий лист: що ви вели, чого навчилися і що хочете взяти на себе далі. Резюме допоможе, але лист важливіший.</p>\n<div class=\"cta-band__actions\"><a class=\"btn btn--primary\" href=\"mailto:careers@ironvane-media.com\"><span>Відгукнутися</span><svg aria-hidden=\"true\" class=\"btn__icon\" fill=\"none\" height=\"14\" viewbox=\"0 0 14 14\" width=\"14\"><path d=\"M1 7h11M8 3l4 4-4 4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.4\"></path></svg></a></div>\n</div>\n</div>\n</section>\n", "footer": "\n<div class=\"container\">\n<div class=\"footer__top\">\n<div class=\"footer__brand\">\n<a aria-label=\"Ironvane Media\" class=\"logo\" href=\"/uk/\">\n<svg aria-hidden=\"true\" class=\"logo__mark\" fill=\"none\" height=\"22\" viewbox=\"0 0 24 24\" width=\"22\"><defs><lineargradient gradientunits=\"userSpaceOnUse\" id=\"ivmMarkf\" x1=\"4\" x2=\"20\" y1=\"0\" y2=\"24\"><stop stop-color=\"#ffffff\"></stop><stop offset=\"0.45\" stop-color=\"#c9ccd2\"></stop><stop offset=\"0.7\" stop-color=\"#82868f\"></stop><stop offset=\"1\" stop-color=\"#ffffff\"></stop></lineargradient></defs><path d=\"M12 0c0 6.627 5.373 12 12 12-6.627 0-12 5.373-12 12 0-6.627-5.373-12-12-12C6.627 12 12 6.627 12 0Z\" fill=\"url(#ivmMarkf)\"></path></svg>\n<span class=\"logo__type\"><span class=\"logo__name\">Ironvane Media</span><span class=\"logo__sub\">Performance systems</span></span>\n</a>\n<p class=\"footer__tagline\">Європейська performance-компанія. Креативна стратегія, медіабаїнг і аналітика працюють однією системою на 73 ринках.</p>\n</div>\n<div class=\"footer__col\"><span class=\"footer__key\">Компанія</span><a class=\"footer__link\" href=\"/uk/about/\">Про компанію</a>\n<a class=\"footer__link\" href=\"/uk/pass/\">Підписки</a>\n<a class=\"footer__link\" href=\"/uk/verticals/\">Вертикалі</a>\n<a class=\"footer__link\" href=\"/uk/results/\">Результати</a>\n<a class=\"footer__link\" href=\"/uk/careers/\">Кар'єра</a>\n<a class=\"footer__link\" href=\"/uk/contact/\">Контакти</a></div>\n<div class=\"footer__col\"><span class=\"footer__key\">Послуги</span><a class=\"footer__link\" href=\"/uk/services/#creative-strategy\">Креативна стратегія</a>\n<a class=\"footer__link\" href=\"/uk/services/#performance-marketing\">Performance-маркетинг</a>\n<a class=\"footer__link\" href=\"/uk/services/#analytics\">Аналітика</a>\n<a class=\"footer__link\" href=\"/uk/services/#cro\">Оптимізація конверсії</a>\n<a class=\"footer__link\" href=\"/uk/services/#market-expansion\">Вихід на нові ринки</a>\n<a class=\"footer__link\" href=\"/uk/services/#creative-production\">Продакшн креативів</a></div>\n<div class=\"footer__col\"><span class=\"footer__key\">Матеріали</span><a class=\"footer__link\" href=\"/uk/insights/\">Матеріали</a>\n<a class=\"footer__link\" href=\"/uk/insights/\">Креативна стратегія</a>\n<a class=\"footer__link\" href=\"/uk/insights/\">Аналітика</a>\n<a class=\"footer__link\" href=\"/uk/insights/\">Тестування креативів</a></div>\n<div class=\"footer__col\"><span class=\"footer__key\">Зв'язок</span><a class=\"footer__link\" href=\"mailto:hello@ironvane-media.com\">hello@ironvane-media.com</a>\n<a class=\"footer__link\" href=\"mailto:careers@ironvane-media.com\">careers@ironvane-media.com</a>\n<a class=\"footer__link\" href=\"https://t.me/ironvane\" rel=\"noopener noreferrer\" target=\"_blank\">Telegram</a></div>\n<div class=\"footer__col footer__col--langs\"><span class=\"footer__key\">Мова</span><div class=\"footer__langs\"><a aria-current=\"false\" class=\"footer__lang\" data-lang=\"en\" href=\"/en/careers/\" hreflang=\"en\" lang=\"en\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-gb\"></use></svg>EN</a>\n<a aria-current=\"false\" class=\"footer__lang\" data-lang=\"ru\" href=\"/ru/careers/\" hreflang=\"ru\" lang=\"ru\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-ru\"></use></svg>RU</a>\n<a aria-current=\"true\" class=\"footer__lang\" data-lang=\"uk\" href=\"/uk/careers/\" hreflang=\"uk\" lang=\"uk\"><svg aria-hidden=\"true\" class=\"flag\" focusable=\"false\" viewbox=\"0 0 16 12\"><use href=\"#flag-ua\"></use></svg>UK</a>\n<a aria-current=\"false\" class=\"footer__lang\" data-lang=\"es\" href=\"/es/careers/\" hreflang=\"es\" lan