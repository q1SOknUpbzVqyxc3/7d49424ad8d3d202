    "<section class=\"hero\">\n<div aria-hidden=\"true\" class=\"hero__ring\">\n<svg viewbox=\"0 0 400 400\">\n<defs>\n<lineargradient id=\"ring\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"1\">\n<stop offset=\"0\" stop-color=\"#7CFFAA\" stop-opacity=\".85\"></stop>\n<stop offset=\".5\" stop-color=\"#14E85C\" stop-opacity=\".25\"></stop>\n<stop offset=\"1\" stop-color=\"#046B39\" stop-opacity=\".7\"></stop>\n</lineargradient>\n</defs>\n<circle cx=\"200\" cy=\"200\" fill=\"none\" r=\"186\" stroke=\"url(#ring)\" stroke-width=\"1.2\"></circle>\n<circle cx=\"200\" cy=\"200\" fill=\"none\" r=\"160\" stroke=\"url(#ring)\" stroke-dasharray=\"3 13\" stroke-width=\"2.5\"></circle>\n<circle cx=\"200\" cy=\"200\" fill=\"none\" r=\"128\" stroke=\"url(#ring)\" stroke-width=\"1\"></circle>\n<g stroke=\"url(#ring)\" stroke-linecap=\"round\" stroke-width=\"4\">\n<line x1=\"200\" x2=\"200\" y1=\"14\" y2=\"42\"></line>\n<line x1=\"386\" x2=\"358\" y1=\"200\" y2=\"200\"></line>\n<line x1=\"200\" x2=\"200\" y1=\"386\" y2=\"358\"></line>\n<line x1=\"14\" x2=\"42\" y1=\"200\" y2=\"200\"></line>\n</g>\n</svg>\n</div>\n\n<svg aria-hidden=\"true\" class=\"coin coin--btc\" viewbox=\"0 0 100 100\">\n<defs>\n<radialgradient cx=\".35\" cy=\".3\" id=\"cg\"><stop offset=\"0\" stop-color=\"#33403A\"></stop><stop offset=\"1\" stop-color=\"#080D0A\"></stop></radialgradient>\n</defs>\n<circle cx=\"50\" cy=\"50\" fill=\"url(#cg)\" r=\"46\" stroke=\"#1B3226\" stroke-width=\"3\"></circle>\n<circle cx=\"50\" cy=\"50\" fill=\"none\" r=\"38\" stroke=\"#14E85C\" stroke-opacity=\".25\" stroke-width=\"1.5\"></circle>\n<text fill=\"#DDE6E2\" font-family=\"Montserrat,sans-serif\" font-size=\"46\" font-weight=\"900\" text-anchor=\"middle\" x=\"50\" y=\"66\">₿</text>\n</svg>\n<svg aria-hidden=\"true\" class=\"coin coin--ton\" viewbox=\"0 0 100 100\">\n<circle cx=\"50\" cy=\"50\" fill=\"url(#cg)\" r=\"46\" stroke=\"#1B3226\" stroke-width=\"3\"></circle>\n<path d=\"M30 38h40L50 74z\" fill=\"none\" stroke=\"#DDE6E2\" stroke-linejoin=\"round\" stroke-width=\"4.5\"></path>\n<path d=\"M50 38v36\" stroke=\"#DDE6E2\" stroke-width=\"4.5\"></path>\n</svg>\n<svg aria-hidden=\"true\" class=\"coin coin--sol\" viewbox=\"0 0 100 100\">\n<circle cx=\"50\" cy=\"50\" fill=\"url(#cg)\" r=\"46\" stroke=\"#1B3226\" stroke-width=\"3\"></circle>\n<g fill=\"#DDE6E2\">\n<path d=\"M32 36h40l-8 9H24z\"></path><path d=\"M32 46h40l-8 9H24z\"></path><path d=\"M32 56h40l-8 9H24z\"></path>\n</g>\n</svg>\n<svg aria-hidden=\"true\" class=\"coin coin--eth\" viewbox=\"0 0 100 100\">\n<circle cx=\"50\" cy=\"50\" fill=\"url(#cg)\" r=\"46\" stroke=\"#1B3226\" stroke-width=\"3\"></circle>\n<path d=\"M50 22 32 52l18 11 18-11z\" fill=\"#DDE6E2\"></path>\n<path d=\"M50 68 32 57l18 21 18-21z\" fill=\"#9AA8A2\"></path>\n</svg>\n<div class=\"wrap\">\n<div class=\"eyebrow hero__eyebrow\">Crypto · Forex · Indices</div>\n<h1>\n<span class=\"hero__word\"><span class=\"chrome\" data-text=\"AMIX\">AMIX</span></span>\n<span class=\"hero__word hero__word--2\"><span class=\"emerald\" data-text=\"TEAM\">TEAM</span></span>\n</h1>\n<p class=\"hero__sub\">Trading team, bot and session reviews — <b>in one place</b>.</p>\n<p class=\"hero__note\">Every trade is published before entry: pair, direction, stop, targets and risk size. A review follows after closing, regardless of the outcome.</p>\n<div class=\"hero__cta\">\n\n<a class=\"btn btn--primary\" href=\"https://t.me/AnastasiaAmixTeam\" rel=\"noopener\" target=\"_blank\">Join Telegram</a>\n<a class=\"btn btn--ghost\" href=\"#products\">What’s included</a>\n</div>\n</div>\n</section>",
    "<div aria-hidden=\"true\" class=\"tape\">\n<div class=\"tape__track\" id=\"tape\"></div>\n</div>",
    "<section class=\"section\" style=\"padding-block:clamp(44px,6vw,72px)\">\n<div class=\"wrap\">\n\n<div class=\"stats reveal\">\n<div class=\"stat\"><div class=\"stat__n\">3 years</div><div class=\"stat__l\">in the market</div></div>\n<div class=\"stat\"><div class=\"stat__n\">1 200+</div><div class=\"stat__l\">participants in a closed channel</div></div>\n<div class=\"stat\"><div class=\"stat__n\">24/7</div><div class=\"stat__l\">bot notifications</div></div>\n<div class=\"stat\"><div class=\"stat__n\">3</div><div class=\"stat__l\">sessions analyzed every day</div></div>\n</div>\n</div>\n</section>",
    "<section class=\"section\" id=\"products\">\n<div class=\"wrap\">\n<div class=\"head--center\">\n<div class=\"eyebrow eyebrow--center\">Three channels</div>\n<h2 class=\"h2\">What’s included? <span class=\"emerald\" data-text=\"AMIX\">AMIX</span></h2>\n<p class=\"lead\">One entry point, three distinct tools: signals, automation and daily session analysis.</p>\n</div>\n<div class=\"grid grid--3\">\n<article class=\"card prod reveal\">\n<div class=\"prod__art\">\n\n\n<svg aria-hidden=\"true\" viewbox=\"0 0 200 200\">\n<g fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n<path d=\"M48 152 L96 48 L144 152\" stroke=\"#E9F0ED\" stroke-width=\"13\"></path>\n<path d=\"M72 112 H120\" stroke=\"#E9F0ED\" stroke-width=\"13\"></path>\n<path d=\"M62 138 L96 96 L118 118 L154 66\" stroke=\"#14E85C\" stroke-width=\"9\"></path>\n<path d=\"M130 60 L158 56 L154 84\" stroke=\"#14E85C\" stroke-width=\"9\"></path>\n</g>\n<text fill=\"#9AA8A2\" font-family=\"Montserrat,sans-serif\" font-size=\"24\" font-style=\"italic\" font-weight=\"900\" text-anchor=\"middle\" x=\"100\" y=\"184\">TEAM</text>\n</svg>\n</div>\n<div class=\"prod__body\">\n<div class=\"prod__tag\">Main channel</div>\n<h3 class=\"prod__title\">AMIX TEAM</h3>\n<p class=\"prod__text\">Entry points with complete chart markings and a clear rationale — before the price moves.</p>\n<ul class=\"prod__list\">\n<li>Entry, stop and targets in each signal</li>\n<li>Risk size as a percentage of your deposit</li>\n<li>Trade review after closing</li>\n</ul>\n<div class=\"prod__foot\">\n<a class=\"btn btn--ghost btn--sm\" href=\"https://t.me/amixteam\" rel=\"noopener\" target=\"_blank\">Open channel</a>\n</div>\n</div>\n</article>\n<article class=\"card prod reveal\">\n<div class=\"prod__art\">\n\n<svg aria-hidden=\"true\" viewbox=\"0 0 200 200\">\n<rect fill=\"#E9F0ED\" height=\"80\" rx=\"26\" width=\"108\" x=\"46\" y=\"62\"></rect>\n<rect fill=\"#061009\" height=\"36\" rx=\"16\" width=\"68\" x=\"66\" y=\"84\"></rect>\n<circle cx=\"88\" cy=\"102\" fill=\"#14E85C\" r=\"7\"></circle><circle cx=\"112\" cy=\"102\" fill=\"#14E85C\" r=\"7\"></circle>\n<path d=\"M100 62V46\" stroke=\"#E9F0ED\" stroke-width=\"6\"></path><circle cx=\"100\" cy=\"40\" fill=\"#14E85C\" r=\"9\"></circle>\n<rect fill=\"#9AA8A2\" height=\"18\" rx=\"9\" width=\"60\" x=\"70\" y=\"142\"></rect>\n</svg>\n</div>\n<div class=\"prod__body\">\n\n<div class=\"prod__tag\">Telegram bot</div>\n<h3 class=\"prod__title\">AMIX TEAM BOT</h3>\n<p class=\"prod__text\">The team’s Telegram bot: instant notifications and quick access to materials.</p>\n<ul class=\"prod__list\">\n<li>Notification as soon as a trade is posted</li>\n<li>Access to discussions and training</li>\n<li>Everything stays in one chat, so nothing gets lost</li>\n</ul>\n<div class=\"prod__foot\">\n<a class=\"btn btn--ghost btn--sm\" href=\"https://t.me/amixteambot\" rel=\"noopener\" target=\"_blank\">Open bot</a>\n</div>\n</div>\n</article>\n<article class=\"card prod reveal\">\n<div class=\"prod__art\">\n\n<svg aria-hidden=\"true\" viewbox=\"0 0 200 200\">\n<rect fill=\"#0E1B14\" height=\"86\" rx=\"10\" stroke=\"#9AA8A2\" stroke-width=\"4\" width=\"132\" x=\"34\" y=\"54\"></rect>\n<rect fill=\"#9AA8A2\" height=\"12\" rx=\"6\" width=\"148\" x=\"26\" y=\"140\"></rect>\n<path d=\"M50 118 L72 92 L92 106 L114 74 L138 96\" fill=\"none\" stroke=\"#14E85C\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"6\"></path>\n<circle cx=\"138\" cy=\"96\" fill=\"#7CFFAA\" r=\"8\"></circle>\n<text fill=\"#8CA096\" font-family=\"JetBrains Mono,monospace\" font-size=\"17\" font-weight=\"700\" letter-spacing=\"3\" text-anchor=\"middle\" x=\"100\" y=\"182\">SESSION</text>\n</svg>\n</div>\n<div class=\"prod__body\">\n<div class=\"prod__tag\">Analysis</div>\n<h3 class=\"prod__title\">AMIX SESSION PHR</h3>\n<p class=\"prod__text\">Daily reviews of the Asian, London and New York sessions: levels, liquidity and a plan for the day.</p>\n<ul class=\"prod__list\">\n<li>Plan before the session opens</li>\n<li>Key levels and areas of interest</li>\n<li>Evening session recap</li>\n</ul>\n<div class=\"prod__foot\">\n<a class=\"btn btn--ghost btn--sm\" href=\"https://t.me/amixsession\" rel=\"noopener\" target=\"_blank\">View session reviews</a>\n</div>\n</div>\n</article>\n</div>\n</div>\n</section>",
    "<section class=\"section\" id=\"why\">\n<div class=\"wrap\">\n<div class=\"head--center\">\n<div class=\"eyebrow eyebrow--center\">Approach</div>\n<h2 class=\"h2\">Why traders stay</h2>\n<p class=\"lead\">We do not promise guaranteed profit. We provide a system you can use to trade independently.</p>\n</div>\n<div class=\"grid grid--4\">\n<article class=\"card reveal\">\n<svg aria-hidden=\"true\" fill=\"none\" height=\"40\" viewbox=\"0 0 40 40\" width=\"40\"><path d=\"M4 32 L14 16 L21 24 L29 10 L36 20\" stroke=\"#14E85C\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\"></path><circle cx=\"36\" cy=\"20\" fill=\"#7CFFAA\" r=\"3.5\"></circle></svg>\n<h3 class=\"card__title\">Trade details — before entry</h3>\n<p class=\"card__text\">The signal is published before the price moves, with complete chart markings. There are no after-the-fact screenshots.</p>\n</article>\n<article class=\"card reveal\">\n<svg aria-hidden=\"true\" fill=\"none\" height=\"40\" viewbox=\"0 0 40 40\" width=\"40\"><path d=\"M20 4 34 10v11c0 8-6 13-14 15-8-2-14-7-14-15V10z\" stroke=\"#14E85C\" stroke-linejoin=\"round\" stroke-width=\"3\"></path><path d=\"M14 20l4.5 5L27 16\" stroke=\"#7CFFAA\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\"></path></svg>\n<h3 class=\"card__title\">Risk in every signal</h3>\n<p class=\"card__text\">Every signal includes a stop and the percentage of the deposit at risk. Without both, it is not posted.</p>\n</article>\n<article class=\"card reveal\">\n<svg aria-hidden=\"true\" fill=\"none\" height=\"40\" viewbox=\"0 0 40 40\" width=\"40\"><circle cx=\"20\" cy=\"20\" r=\"15\" stroke=\"#14E85C\" stroke-width=\"3\"></circle><path d=\"M20 11v10l7 4\" stroke=\"#7CFFAA\" stroke-linecap=\"round\" stroke-width=\"3\"></path></svg>\n<h3 class=\"card__title\">Reviewing mistakes</h3>\n<p class=\"card__text\">Losing trades are analyzed in the same detail as profitable trades. This is how skill grows.</p>\n</article>\n<article class=\"card reveal\">\n<svg aria-hidden=\"true\" fill=\"none\" height=\"40\" viewbox=\"0 0 40 40\" width=\"40\"><circle cx=\"14\" cy=\"13\" r=\"6\" stroke=\"#14E85C\" stroke-width=\"3\"></circle><circle cx=\"28\" cy=\"16\" r=\"4.5\" stroke=\"#7CFFAA\" stroke-width=\"3\"></circle><path d=\"M4 34c0-6 4.5-9 10-9s10 3 10 9\" stroke=\"#14E85C\" stroke-linecap=\"round\" stroke-width=\"3\"></path><path d=\"M27 34c0-4 2-6 5-6s4 2 4 5\" stroke=\"#7CFFAA\" stroke-linecap=\"round\" stroke-width=\"3\"></path></svg>\n<h3 class=\"card__title\">Training from scratch</h3>\n<p class=\"card__text\">From market structure to your own plan. The goal is for signals to become unnecessary.</p>\n</article>\n</div>\n</div>\n</section>",
    "<section class=\"section\" id=\"results\">\n<div class=\"wrap\">\n<div class=\"head--center\">\n<div class=\"eyebrow eyebrow--center\">Trade journal</div>\n<h2 class=\"h2\">Transparent results</h2>\n<p class=\"lead\">Every trade from the channel is recorded in the journal, whether profitable or losing. R expresses the result in risk units: +2.0R means earning twice the amount risked.</p>\n<div class=\"sample-tag\">Sample entries — replace with actual trades</div>\n</div>\n\n<div class=\"jsum reveal\" id=\"journalSum\"></div>\n<div class=\"grid grid--2 grid--tight\" id=\"journal\"></div>\n<p class=\"disclaimer reveal\"><b style=\"color:var(--text)\">Important.</b> Past trading results do not guarantee future returns. Leveraged trading carries a risk of losing your entire deposit. We do not manage client funds or accept money under discretionary management.</p>\n</div>\n</section>",
    "<section class=\"section\" id=\"start\">\n<div class=\"wrap\">\n<div class=\"head--center\">\n<div class=\"eyebrow eyebrow--center\">Three steps</div>\n<h2 class=\"h2\">How to get started</h2>\n</div>\n<div class=\"steps\">\n<article class=\"card step reveal\">\n<h3 class=\"card__title\" style=\"margin-top:0\">Contact HR</h3>\n<p class=\"card__text\">Write to our HR on Telegram. You tell us about your experience and what you want to get from working with the team.</p>\n</article>\n<article class=\"card step reveal\">\n<h3 class=\"card__title\" style=\"margin-top:0\">We agree on the terms</h3>\n<p class=\"card__text\">We discuss the working format, the plan and what it includes. Every question is settled before you start.</p>\n</article>\n<article class=\"card step reveal\">\n<h3 class=\"card__title\" style=\"margin-top:0\">Start working</h3>\n<p class=\"card__text\">You receive access and connect with the team. From there, you get signals, analysis and support.</p>\n</article>\n</div>\n</div>\n</section>",
    "<section class=\"section\" id=\"plans\">\n<div class=\"wrap\">\n<div class=\"head--center\">\n<div class=\"eyebrow eyebrow--center\">Access</div>\n<h2 class=\"h2\">Plans</h2>\n<p class=\"lead\">You can start for free. Choose paid access once you know the approach suits you.</p>\n</div>\n\n<div class=\"grid grid--3\">\n<article class=\"card plan reveal\">\n<div class=\"plan__name\">Free</div>\n<div class=\"plan__price\">0 ₽</div>\n<ul class=\"plan__list\">\n<li class=\"on\">Open channel</li>\n<li class=\"on\">Latest news in the world of crypto</li>\n<li>Closed signals</li>\n<li>Full support</li>\n<li>Answers to your questions at any time</li>\n</ul>\n\n<div class=\"plan__foot\"><a class=\"btn btn--ghost\" href=\"https://t.me/amixteam\" rel=\"noopener\" style=\"width:100%\" target=\"_blank\">Open channel</a></div>\n</article>\n<article class=\"card plan plan--best reveal\">\n<span class=\"plan__badge\">Team choice</span>\n<div class=\"plan__name\">Pro</div>\n<div class=\"plan__price\">80 000 ₽</div>\n<ul class=\"plan__list\">\n<li class=\"on\">Everything in Free</li>\n<li class=\"on\">Closed signals</li>\n<li class=\"on\">Full support</li>\n<li class=\"on\">Answers to your questions at any time</li>\n<li class=\"on\">Training archive</li>\n<li>Personal trade-journal review</li>\n</ul>\n<div class=\"plan__foot\"><a class=\"btn btn--primary\" href=\"https://t.me/AnastasiaAmixTeam\" rel=\"noopener\" style=\"width:100%\" target=\"_blank\">Contact HR</a></div>\n</article>\n<article class=\"card plan reveal\">\n<div class=\"plan__name\">Private</div>\n<div class=\"plan__price\">150 000 ₽</div>\n<ul class=\"plan__list\">\n<li class=\"on\">Everything in Pro</li>\n<li class=\"on\">Personal trade-journal review</li>\n<li class=\"on\">Calls with the team</li>\n<li class=\"on\">Priority responses</li>\n<li class=\"on\">Limited availability</li>\n</ul>\n<div class=\"plan__foot\"><a class=\"btn btn--ghost\" href=\"https://t.me/AnastasiaAmixTeam\" rel=\"noopener\" style=\"width:100%\" target=\"_blank\">Contact HR</a></div>\n</article>\n</div>\n</div>\n</section>",
    "<section class=\"section\" id=\"reviews\">\n<div class=\"wrap\">\n<div class=\"head--center\">\n<div class=\"eyebrow eyebrow--center\">Participants</div>\n<h2 class=\"h2\">What they say on the team</h2>\n</div>\n\n<div class=\"grid grid--3\">\n<article class=\"card review reveal\">\n<span class=\"review__badge\">Example</span>\n<p class=\"review__body\">The first two months I just watched the team break down the sessions and kept a journal. When I started taking trades myself, I already understood why the entry was here and not ten points higher.</p>\n<div class=\"review__who\">\n<div class=\"review__ava\"><svg aria-hidden=\"true\" fill=\"#03150B\" viewbox=\"0 0 20 20\"><circle cx=\"10\" cy=\"6.4\" r=\"3.6\"></circle><path d=\"M2.6 18c0-4.1 3.3-6.6 7.4-6.6s7.4 2.5 7.4 6.6z\"></path></svg></div>\n<div><div class=\"review__name\">Team member</div><div class=\"review__meta\">6 months</div></div>\n</div>\n</article>\n<article class=\"card review reveal\">\n<span class=\"review__badge\">Example</span>\n<p class=\"review__body\">The analysis of negative trades gave the most results. Previously, after a loss I tried to win back, now I close the terminal and write down what went wrong. Drawdowns have become noticeably shorter.</p>\n<div class=\"review__who\">\n<div class=\"review__ava\"><svg aria-hidden=\"true\" fill=\"#03150B\" viewbox=\"0 0 20 20\"><circle cx=\"10\" cy=\"6.4\" r=\"3.6\"></circle><path d=\"M2.6 18c0-4.1 3.3-6.6 7.4-6.6s7.4 2.5 7.4 6.6z\"></path></svg></div>\n<div><div class=\"review__name\">Team member</div><div class=\"review__meta\">4 months</div></div>\n</div>\n</article>\n<article class=\"card review reveal\">\n<span class=\"review__badge\">Example</span>\n<p class=\"review__body\">It is valuable that the risk is considered before entering. I know how much I lose in the worst case, even before opening a position - on my nerves, this turned out to be more important than the percentage of profit itself.</p>\n<div class=\"review__who\">\n<div class=\"review__ava\"><svg aria-hidden=\"true\" fill=\"#03150B\" viewbox=\"0 0 20 20\"><circle cx=\"10\" cy=\"6.4\" r=\"3.6\"></circle><path d=\"M2.6 18c0-4.1 3.3-6.6 7.4-6.6s7.4 2.5 7.4 6.6z\"></path></svg></div>\n<div><div class=\"review__name\">Team member</div><div class=\"review__meta\">more than a year</div></div>\n</div>\n</article>\n</div>\n</div>\n</section>",
    "<section class=\"section\" id=\"faq\">\n<div class=\"wrap\">\n<div class=\"head--center\">\n<div class=\"eyebrow eyebrow--center\">Questions</div>\n<h2 class=\"h2\">Frequently asked questions</h2>\n</div>\n<div class=\"faq\">\n<details open=\"\">\n<summary>Do you guarantee profit?</summary>\n<p>No. Nobody in the market can guarantee profit. We provide signals with calculated risk and teach a systematic approach; the result depends on your discipline and money management.</p>\n</details>\n<details>\n<summary>Do you need experience to get started?</summary>\n<p>No. The open part contains the basics: market structure, levels, risk management. You can start with a minimum deposit and observation mode.</p>\n</details>\n<details>\n<summary>Do you accept funds for management?</summary>\n<p>No. We do not manage other people's funds and do not ask for deposit transfers. Your money remains in your account with your broker or exchange.</p>\n</details>\n<details>\n<summary>What markets do you trade?</summary>\n<p>Cryptocurrency pairs, major currency pairs, gold and indices. A specific list of tools is in a closed channel.</p>\n</details>\n<details>\n<summary>How much time do you need per day?</summary>\n<p>A session review takes 10–15 minutes. Trades arrive through the bot, so you do not need to watch the terminal all day.</p>\n</details>\n</div>\n</div>\n</section>",
    "<section class=\"section\" style=\"padding-top:0\">\n<div class=\"wrap\">\n<div class=\"cta reveal\">\n<h2 class=\"cta__title\">Come to <span class=\"emerald\" data-text=\"AMIX TEAM\">AMIX TEAM</span></h2>\n<p class=\"cta__sub\">The open part is free. See how we work before you pay.</p>\n<div class=\"hero__cta\">\n<a class=\"btn btn--primary\" href=\"https://t.me/AnastasiaAmixTeam\" rel=\"noopener\" target=\"_blank\">Join Telegram</a>\n<a class=\"btn btn--ghost\" href=\"#plans\">View plans</a>\n</div>\n</div>\n</div>\n</section>"
  ],
  "footer": "\n<div class=\"wrap\">\n<div class=\"footer__top\">\n<div class=\"footer__brand\">\n<span class=\"chrome\" data-text=\"AMIX\">AMIX</span>\n<p class=\"footer__about\">Trading team: risk-managed signals, a Telegram bot and daily trading-session reviews.</p>\n</div>\n<div>\n<div class=\"footer__h\">Products</div>\n<ul class=\"footer__list\">\n<li><a href=\"https://t.me/amixteam\" rel=\"noopener\" target=\"_blank\">AMIX TEAM</a></li>\n<li><a href=\"https://t.me/amixteambot\" rel=\"noopener\" target=\"_blank\">AMIX TEAM BOT</a></li>\n<li><a href=\"https://t.me/amixsession\" rel=\"noopener\" target=\"_blank\">AMIX SESSION PHR</a></li>\n</ul>\n</div>\n<div>\n<div class=\"footer__h\">Sections</div>\n<ul class=\"footer__list\">\n<li><a href=\"#results\">Results</a></li>\n<li><a href=\"#plans\">Plans</a></li>\n<li><a href=\"#faq\">FAQ</a></li>\n</ul>\n</div>\n</div>\n<div class=\"risk\">\n<b>Risk warning.</b> Trading in the financial and cryptocurrency markets involves high risk and is not suitable for all investors. Using leverage may result in the loss of your entire deposit. Past performance is no guarantee of future performance. AMIX TEAM materials are for informational and educational purposes only and do not constitute an individual investment recommendation. You make decisions about transactions independently and at your own risk.\n    </div>\n<div class=\"footer__bottom\">\n<span>© 2026 AMIX TEAM</span>\n<span>Not investment advice</span>\n</div>\n</div>\n"
